  SATELLITES.forEach(s => {
    const sigColor = s.signal >= 95 ? 'green' : s.signal >= 90 ? 'gold' : 'orange';
    h += `<div class="sat-card">
      <div class="sat-icon"><i class="fas fa-satellite"></i></div>
      <div class="info">
        <div class="name">${s.id}</div>
        <div class="orbit">${s.orbit} · ${s.alt} · Band ${s.band}</div>
        <div class="orbit">📅 ${s.launch} · ⏱️ ${s.period}</div>
        <div class="orbit">${s.type}</div>
      </div>
      <div class="signal ${sigColor}">${s.signal}%</div>
    </div>`;
  });
  h += `</div>
    <h3>📊 Butiran Teknikal</h3>
    ${table(["ID","Orbit","Altitud","Band","Signal","Jenis","Launch","Period"],
      SATELLITES.map(s => [s.id, s.orbit, s.alt, s.band, s.signal + '%', s.type, s.launch, s.period]),
      ["mono","cyan","gold","purple","green","","",""])}`;
  $('satContent').innerHTML = h;
  
  // ORBIT VIZ
  let viz = `<div class="orbit-viz" id="orbitVizContainer">
    <div class="earth"></div>`;
  const orbitDefs = [
    { radius: 100, color:'#00e5ff', label:'LEO 550km' },
    { radius: 150, color:'#a855f7', label:'MEO 20,200km' },
    { radius: 200, color:'#fbbf24', label:'GEO 35,786km' },
    { radius: 175, color:'#ec4899', label:'SSO 700km' }
  ];
  orbitDefs.forEach(o => {
    viz += `<div class="orbit" style="width:${o.radius*2}px;height:${o.radius*2}px;border-color:${o.color}40"></div>`;
  });
  viz += `<div style="position:absolute;top:20px;left:20px;font-size:11px;color:var(--muted)">
    <div>🟦 Earth (Blue Marble)</div>
    ${orbitDefs.map(o => `<div style="color:${o.color}">● ${o.label}</div>`).join('')}
  </div>`;
  SATELLITES.forEach((s, i) => {
    const r = s.orbit === 'LEO' ? 100 : s.orbit === 'MEO' ? 150 : s.orbit === 'GEO' ? 200 : 175;
    const angle = (i * 60 + Date.now()/100) % 360;
    const x = 50 + (Math.cos(angle * Math.PI/180) * r / 4);
    const y = 50 + (Math.sin(angle * Math.PI/180) * r / 4);
    viz += `<div class="sat" style="left:calc(${x}% - 5px);top:calc(${y}% - 5px);background:${s.signal>=95?'#00e5ff':s.signal>=90?'#fbbf24':'#ef4444'}" title="${s.id} · ${s.orbit}"></div>`;
  });
  viz += `</div>`;
  $('orbitViz').innerHTML = viz;
  
  // GROUND STATIONS
  let gs = `<div class="kpi-grid">
    <div class="kpi"><div class="label">Total GS</div><div class="value cyan">${GROUND_STATIONS.length}</div></div>
    <div class="kpi"><div class="label">Bands</div><div class="value gold">Ka/X/Ku/L</div></div>
    <div class="kpi"><div class="label">Uplink</div><div class="value green">2.4 Gbps</div></div>
    <div class="kpi"><div class="label">Downlink</div><div class="value purple">2.4 Gbps</div></div>
  </div>${table(["ID","Lokasi","Flag","Dish","Status"],
    GROUND_STATIONS.map(g => [g.id, g.city, g.flag, g.dish, 'ACTIVE']),
    ["mono","cyan","","gold","green"])}`;
  $('gsContent').innerHTML = gs;
}

