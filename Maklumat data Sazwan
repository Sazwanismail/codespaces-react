function init3DGlobe() {
  const container = $('globeContainer');
  if (!container || globeScene) return;
  
  // Import Three.js dynamically if not loaded
  if (typeof THREE === 'undefined') {
    const script = document.createElement('script');
    script.src = 'https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.min.js';
    script.onload = () => {
      const orbitScript = document.createElement('script');
      orbitScript.src = 'https://cdn.jsdelivr.net/npm/three@0.160.0/examples/js/controls/OrbitControls.js';
      orbitScript.onload = () => createGlobe(container);
      document.head.appendChild(orbitScript);
    };
    document.head.appendChild(script);
  } else {
    createGlobe(container);
  }
}

function createGlobe(container) {
  const width = container.clientWidth;
  const height = container.clientHeight;
  
  globeScene = new THREE.Scene();
  globeCamera = new THREE.PerspectiveCamera(45, width/height, 0.1, 1000);
  globeCamera.position.set(0, 0, 3.5);
  
  globeRenderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
  globeRenderer.setSize(width, height);
  globeRenderer.setPixelRatio(window.devicePixelRatio);
  container.innerHTML = '';
  container.appendChild(globeRenderer.domElement);
  
  // Controls
  const controls = new THREE.OrbitControls(globeCamera, globeRenderer.domElement);
  controls.enableDamping = true;
  controls.dampingFactor = 0.05;
  controls.minDistance = 1.8;
  controls.maxDistance = 8;
  
  // Lights
  globeScene.add(new THREE.AmbientLight(0x404060, 1));
  const dirLight = new THREE.DirectionalLight(0xffffff, 1.2);
  dirLight.position.set(5, 3, 5);
  globeScene.add(dirLight);
  const backLight = new THREE.PointLight(0x00e5ff, 0.8);
  backLight.position.set(-3, -2, -3);
  globeScene.add(backLight);
  
  // Globe group
  globeGroup = new THREE.Group();
  globeScene.add(globeGroup);
  
  // Earth sphere with texture (using procedural or online texture)
  const earthGeo = new THREE.SphereGeometry(1, 64, 64);
  const textureLoader = new THREE.TextureLoader();
  const earthTexture = textureLoader.load('https://unpkg.com/three-globe/example/img/earth-blue-marble.jpg', 
    undefined, undefined, () => {
      // Fallback to procedural
      const earthMat = new THREE.MeshPhongMaterial({ color: 0x1e3a5f, emissive: 0x0a1a3f, emissiveIntensity: 0.3 });
      const earthMesh = new THREE.Mesh(earthGeo, earthMat);
      globeGroup.add(earthMesh);
    }
  );
  const earthMat = new THREE.MeshPhongMaterial({ 
    map: earthTexture, 
    emissive: 0x0a1a3f,
    emissiveIntensity: 0.2,
    shininess: 10
  });
  const earth = new THREE.Mesh(earthGeo, earthMat);
  globeGroup.add(earth);
  
  // Wireframe overlay
  const wireGeo = new THREE.SphereGeometry(1.002, 32, 32);
  const wireMat = new THREE.MeshBasicMaterial({ color: 0x00e5ff, wireframe: true, transparent: true, opacity: 0.06 });
  globeGroup.add(new THREE.Mesh(wireGeo, wireMat));
  
  // Atmosphere glow
  const atmoGeo = new THREE.SphereGeometry(1.05, 32, 32);
  const atmoMat = new THREE.MeshBasicMaterial({ color: 0x00e5ff, transparent: true, opacity: 0.08, side: THREE.BackSide });
  globeGroup.add(new THREE.Mesh(atmoGeo, atmoMat));
  
  // Convert lat/lng to 3D coords
  function latLngToXYZ(lat, lng, radius) {
    const phi = (90 - lat) * Math.PI / 180;
    const theta = (lng + 180) * Math.PI / 180;
    return new THREE.Vector3(
      -radius * Math.sin(phi) * Math.cos(theta),
      radius * Math.cos(phi),
      radius * Math.sin(phi) * Math.sin(theta)
    );
  }
  
  // Add markers
  function addMarker(lat, lng, color, size = 0.02, label = '') {
    const pos = latLngToXYZ(lat, lng, 1.02);
    const geo = new THREE.SphereGeometry(size, 8, 8);
    const mat = new THREE.MeshBasicMaterial({ color: color });
    const marker = new THREE.Mesh(geo, mat);
    marker.position.copy(pos);
    globeGroup.add(marker);
    
    // Glow
    const glowGeo = new THREE.SphereGeometry(size * 1.8, 8, 8);
    const glowMat = new THREE.MeshBasicMaterial({ color: color, transparent: true, opacity: 0.3 });
    const glow = new THREE.Mesh(glowGeo, glowMat);
    glow.position.copy(pos);
    globeGroup.add(glow);
  }
  
  // GRAN Tanah (green)
  GRAN_TANAH.forEach(g => addMarker(g.lat, g.lng, 0x34d399, 0.025));
  // GRAN Global (yellow)
  GRAN_GLOBAL.forEach(g => addMarker(g.lat, g.lng, 0xfbbf24, 0.02));
  // Family Home (pink)
  addMarker(FAMILY_HOME.lat, FAMILY_HOME.lng, 0xec4899, 0.035);
  
  // Satellite orbits
  satOrbitGroup = new THREE.Group();
  globeScene.add(satOrbitGroup);
  
  const orbitColors = { LEO: 0x00e5ff, MEO: 0xa855f7, GEO: 0xfbbf24, SSO: 0xec4899 };
  const orbitRadii = { LEO: 1.3, MEO: 1.6, GEO: 1.9, SSO: 1.75 };
  
  // Draw orbit rings
  ['LEO', 'MEO', 'GEO', 'SSO'].forEach(orbitType => {
    const r = orbitRadii[orbitType];
    const points = [];
    for (let i = 0; i <= 64; i++) {
      const angle = (i / 64) * Math.PI * 2;
      points.push(new THREE.Vector3(r * Math.cos(angle), 0, r * Math.sin(angle)));
    }
    const orbitGeo = new THREE.BufferGeometry().setFromPoints(points);
    const orbitMat = new THREE.LineBasicMaterial({ color: orbitColors[orbitType], transparent: true, opacity: 0.4 });
    const orbitLine = new THREE.Line(orbitGeo, orbitMat);
    satOrbitGroup.add(orbitLine);
    
    // Rotate GEO orbit to be equatorial, LEO inclined, SSO polar
    if (orbitType === 'LEO') orbitLine.rotation.x = Math.PI / 6;
    if (orbitType === 'SSO') orbitLine.rotation.x = Math.PI / 2;
  });
  
  // Add satellites moving along orbits
  const satMeshes = SATELLITES.map((s, i) => {
    const r = orbitRadii[s.orbit] || 1.3;
    const satGeo = new THREE.SphereGeometry(0.018, 8, 8);
    const satMat = new THREE.MeshBasicMaterial({ color: orbitColors[s.orbit] });
    const satMesh = new THREE.Mesh(satGeo, satMat);
    satMesh.userData = { radius: r, speed: 0.3 + i * 0.05, angle: i * Math.PI / 3, orbit: s.orbit };
    satOrbitGroup.add(satMesh);
    return satMesh;
  });
  
  // Animation loop
  const clock = new THREE.Clock();
  function animate() {
    animationId = requestAnimationFrame(animate);
    const t = clock.getElapsedTime();
    
    if (globeRotation) globeGroup.rotation.y += 0.0015;
    
    // Move satellites
    satMeshes.forEach(sat => {
      sat.userData.angle += sat.userData.speed * 0.01;
      const a = sat.userData.angle;
      const r = sat.userData.radius;
      sat.position.set(r * Math.cos(a), 0, r * Math.sin(a));
      // Apply orbit tilt
      if (sat.userData.orbit === 'LEO') {
        sat.position.applyAxisAngle(new THREE.Vector3(1, 0, 0), Math.PI / 6);
      } else if (sat.userData.orbit === 'SSO') {
        sat.position.applyAxisAngle(new THREE.Vector3(1, 0, 0), Math.PI / 2);
      }
    });
    
    satOrbitGroup.rotation.y += 0.0008;
    controls.update();
    globeRenderer.render(globeScene, globeCamera);
  }
  animate();
  
  // Resize handler
  window.addEventListener('resize', () => {
    const w = container.clientWidth, h = container.clientHeight;
    if (w && h) {
      globeCamera.aspect = w / h;
      globeCamera.updateProjectionMatrix();
      globeRenderer.setSize(w, h);
    }
  });
}

function toggleGlobeRotation() {
  globeRotation = !globeRotation;
  alert('🌐 Globe rotation: ' + (globeRotation ? 'AKTIF' : 'PAUSE'));
}

function toggleSatelliteOrbits() {
  if (satOrbitGroup) {
    satOrbitGroup.visible = !satOrbitGroup.visible;
    alert('🛰️ Satellite orbits: ' + (satOrbitGroup.visible ? 'VISIBLE' : 'HIDDEN'));
  }
}

function renderGlobe() {
  setTimeout(init3DGlobe, 300);
}
