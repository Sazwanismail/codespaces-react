// ============================================================
//  1. GRAN CHART
// ============================================================
function renderGranChart() {
  // GRAN TANAH
  const tanahSorted = [...GRAN_TANAH].sort((a,b) => {
    return parseInt(b.value.replace(/[^0-9]/g,'')) - parseInt(a.value.replace(/[^0-9]/g,''));
  });
  const maxTanah = parseInt(tanahSorted[0].value.replace(/[^0-9]/g,''));
  
  let h1 = `<div style="margin-bottom:12px;color:var(--muted);font-size:12px">📌 12 lot GRAN Tanah — nilai tertinggi: <span class="gold">${tanahSorted[0].name}</span></div>`;
  tanahSorted.forEach(g => {
    const val = parseInt(g.value.replace(/[^0-9]/g,''));
    const pct = (val / maxTanah) * 100;
    h1 += `<div class="gran-bar">
      <div class="label">${g.flag} ${g.state}</div>
      <div class="track"><div class="fill" style="width:${pct}%">${pct.toFixed(1)}%</div></div>
      <div class="value">${g.value}</div>
    </div>`;
  });
  $('granChartTanah').innerHTML = h1;
  
  // GRAN GLOBAL
  const globalSorted = [...GRAN_GLOBAL].sort((a,b) => {
    return parseInt(b.value.replace(/[^0-9]/g,'')) - parseInt(a.value.replace(/[^0-9]/g,''));
  });
  const maxGlobal = parseInt(globalSorted[0].value.replace(/[^0-9]/g,''));
  
  let h2 = `<div style="margin-bottom:12px;color:var(--muted);font-size:12px">📌 12 lot GRAN Global — nilai tertinggi: <span class="gold">${globalSorted[0].name}</span></div>`;
  globalSorted.forEach(g => {
    const val = parseInt(g.value.replace(/[^0-9]/g,''));
    const pct = (val / maxGlobal) * 100;
    h2 += `<div class="gran-bar">
      <div class="label">${g.flag} ${g.country}</div>
      <div class="track"><div class="fill" style="width:${pct}%;background:linear-gradient(90deg,#00e5ff,#a855f7)">${pct.toFixed(1)}%</div></div>
      <div class="value">${g.value}</div>
    </div>`;
  });
  $('granChartGlobal').innerHTML = h2;
  
  // TIMELINE
  const timeline = [
    { year: 2024, lots: 3, value: 18600000 },
    { year: 2025, lots: 6, value: 142000000 },
    { year: 2026, lots: 24, value: 1168800000 },
    { year: 2027, lots: 30, value: 1420000000 },
    { year: 2028, lots: 36, value: 2280000000 },
    { year: 2030, lots: 42, value: 4800000000 }
  ];
  const maxValue = Math.max(...timeline.map(t => t.value));
  let h3 = `<div style="margin-bottom:12px;color:var(--muted);font-size:12px">📈 Pertumbuhan nilai GRAN dari 2024 hingga 2030</div>`;
  timeline.forEach(t => {
    const pct = (t.value / maxValue) * 100;
    const fmt = t.value >= 1e9 ? 'RM ' + (t.value/1e9).toFixed(2) + 'B' : 'RM ' + (t.value/1e6).toFixed(1) + 'M';
    h3 += `<div class="timeline-item">
      <div class="year">${t.year}</div>
      <div class="bar-track"><div class="bar-fill" style="width:${pct}%"></div></div>
      <div class="val">${fmt} · ${t.lots} lot</div>
    </div>`;
  });
  $('granTimeline').innerHTML = h3;
}

