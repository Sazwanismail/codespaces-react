      document.getElementById('ip-address').classList.remove('loading');

      const r2 = await fetch(`http://ip-api.com/json/${d1.ip}`);
      const d2 = await r2.json();
      const flag = getFlagEmoji(d2.countryCode);
      document.getElementById('ip-location').innerHTML = `${flag} ${d2.city || '-'}, ${d2.regionName || '-'}, ${d2.country || '-'}`;
      document.getElementById('ip-location').classList.remove('loading');
      document.getElementById('ip-isp').textContent = d2.isp || d2.org || '-';
      document.getElementById('ip-isp').classList.remove('loading');
      document.getElementById('ip-timezone').textContent = d2.timezone || '-';
      document.getElementById('ip-timezone').classList.remove('loading');
      addLog(`🌐 IP (fallback): ${d1.ip}`);
    } catch (e2) {
      document.getElementById('ip-address').textContent = 'Tidak dapat diambil';
      document.getElementById('ip-address').className = 'error';
      document.getElementById('ip-location').textContent = '-';
      document.getElementById('ip-isp').textContent = '-';
      document.getElementById('ip-timezone').textContent = '-';
      addLog('⚠️ Gagal mendapatkan data IP');
    }
  }
}

function getFlagEmoji(code) {
  if (!code) return '🌍';
  return code.toUpperCase().replace(/./g, c =>
    String.fromCodePoint(127397 + c.charCodeAt())
  );
}

function getSystemInfo() {
  const ua = navigator.userAgent;

  let os = 'Tidak diketahui';
  if (ua.includes('Windows')) os = 'Windows';
  else if (ua.includes('Mac OS X')) os = 'macOS';
  else if (ua.includes('Android')) os = 'Android';
  else if (ua.includes('iPhone') || ua.includes('iPad')) os = 'iOS';
  else if (ua.includes('Linux')) os = 'Linux';
  document.getElementById('sys-os').textContent = os;
  document.getElementById('sys-os').classList.remove('loading');

  let browser = 'Tidak diketahui';
  if (ua.includes('Edg/')) browser = 'Microsoft Edge';
  else if (ua.includes('Chrome/') && !ua.includes('Edg/')) browser = 'Google Chrome';
  else if (ua.includes('Firefox/')) browser = 'Mozilla Firefox';
  else if (ua.includes('Safari/') && !ua.includes('Chrome')) browser = 'Safari';
  else if (ua.includes('Opera') || ua.includes('OPR/')) browser = 'Opera';
  document.getElementById('sys-browser').textContent = browser;
