```js
// ═══════════════════════════════════════════════════════════════════════════
// MODULE: INTERNET DATA
// ═══════════════════════════════════════════════════════════════════════════

async function fetchInternet() {
  const start = performance.now();
  try {
    // Primary: ipapi.co (free, no key)
    const r = await fetch('https://ipapi.co/json/');
    const d = await r.json();
    const latency = Math.round(performance.now() - start);
    STATE.health.ipapi = { latency, status: 'ok' };

    document.getElementById('net-ip').textContent = d.ip || '--';
    document.getElementById('net-ip-meta').textContent = (d.version || 'IPv4') + ' · ' + (d.country_code || '--');
    document.getElementById('net-isp').textContent = (d.org || 'Unknown').substring(0, 28);
    document.getElementById('net-asn').textContent = d.asn || 'ASN --';
    document.getElementById('net-loc').textContent = (d.city || '--') + ', ' + (d.country_name || '--');
    document.getElementById('net-geo').textContent = (d.latitude || 0).toFixed(3) + ', ' + (d.longitude || 0).toFixed(3);
    document.getElementById('net-tz').textContent = d.timezone || '--';
    document.getElementById('net-utc').textContent = d.utc_offset || 'UTC --';

    // Gauges
    const gauges = document.getElementById('net-gauges');
    const conn = navigator.connection || navigator.mozConnection || navigator.webkitConnection || {};
    const downlink = conn.downlink || 0;
    const rtt = conn.rtt || 0;
    const effectiveType = conn.effectiveType || 'unknown';
    const saveData = conn.saveData ? 'ON' : 'OFF';

    const g = [
      { v: latency, u: 'ms', l: 'IP API Latency', cls: latency < 300 ? 'good' : latency < 800 ? 'warn' : 'bad', pct: Math.min(100, 100 - latency / 15) },
      { v: downlink.toFixed(1), u: 'Mbps', l: 'Downlink Est.', cls: downlink > 5 ? 'good' : downlink > 1 ? 'warn' : 'bad', pct: Math.min(100, downlink * 10) },
      { v: rtt, u: 'ms', l: 'Round-Trip Time', cls: rtt < 100 ? 'good' : rtt < 300 ? 'warn' : 'bad', pct: Math.min(100, 100 - rtt / 5) },
      { v: effectiveType.toUpperCase(), u: '', l: 'Effective Type', cls: effectiveType.includes('4g') ? 'good' : 'warn', pct: effectiveType.includes('4g') ? 100 : 50 },
      { v: saveData, u: '', l: 'Data Saver', cls: saveData === 'OFF' ? 'good' : 'warn', pct: saveData === 'OFF' ? 100 : 40 },
      { v: navigator.onLine ? 'YES' : 'NO', u: '', l: 'Online Status', cls: navigator.onLine ? 'good' : 'bad', pct: navigator.onLine ? 100 : 0 },
    ];

    gauges.innerHTML = g.map(x => `
      <div class="gauge ${x.cls}">
        <div class="val">${x.v}<span class="unit">${x.u}</span></div>
        <div class="lbl">${x.l}</div>
        <div class="bar"><div style="width:${Math.max(4, Math.min(100, x.pct))}%"></div></div>
      </div>
    `).join('');

    // HTTP headers (via httpbin)
    fetchHeaderCheck();
    fetchSecurityCheck();

  } catch (e) {
    document.getElementById('net-gauges').innerHTML =
      `<div class="loading" style="color:var(--red);"><i class="fas fa-exclamation-triangle"></i> ${e.message}</div>`;
    STATE.health.ipapi = { latency: 0, status: 'error' };
  }
}

async function fetchHeaderCheck() {
  const el = document.getElementById('net-headers');
  try {
    const r = await fetch('https://httpbin.org/headers');
    const d = await r.json();
    const h = d.headers || {};
    const rows = Object.entries(h).slice(0, 8).map(([k, v]) => `
      <div class="metric-row">
        <span class="k">${k}</span>
        <span class="v" style="font-size:0.62rem;max-width:55%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="${v}">${String(v).substring(0, 30)}</span>
      </div>
    `).join('');
    el.innerHTML = rows || '<div class="loading">No headers</div>';
  } catch (e) {
    el.innerHTML = `<div class="loading" style="color:var(--gold);">httpbin tidak tersedia</div>`;
  }
}

async function fetchSecurityCheck() {
  const el = document.getElementById('net-security');
  const proto = location.protocol;
  const isSecure = proto === 'https:';
  const isLocal = location.hostname === 'localhost' || location.hostname.startsWith('127.');
  const sw = 'serviceWorker' in navigator;
  const crypto = !!(window.crypto && window.crypto.subtle);
  const storage = (() => { try { localStorage.setItem('_t', '1'); localStorage.removeItem('_t'); return true; } catch { return false; } })();

  el.innerHTML = `
    <div class="metric-row"><span class="k">Protocol</span><span class="v ${isSecure || isLocal ? 'good' : 'bad'}">${proto.toUpperCase().replace(':','')}</span></div>
    <div class="metric-row"><span class="k">Secure Context</span><span class="v ${isSecure || isLocal ? 'good' : 'bad'}">${isSecure || isLocal ? 'YES' : 'NO'}</span></div>
    <div class="metric-row"><span class="k">Service Worker</span><span class="v ${sw ? 'good' : 'warn'}">${sw ? 'SUPPORTED' : 'N/A'}</span></div>
    <div class="metric-row"><span class="k">Web Crypto API</span><span class="v ${crypto ? 'good' : 'warn'}">${crypto ? 'AVAILABLE' : 'N/A'}</span></div>
    <div class="metric-row"><span class="k">Local Storage</span><span class="v ${storage ? 'good' : 'bad'}">${storage ? 'WRITABLE' : 'BLOCKED'}</span></div>
    <div class="metric-row"><span class="k">Cookies Enabled</span><span class="v ${navigator.cookieEnabled ? 'good' : 'warn'}">${navigator.cookieEnabled ? 'YES' : 'NO'}</span></div>
  `;
}

async function fetchReachability() {
  const el = document.getElementById('net-reach');
  const targets = [
    { name: 'CoinGecko', url: 'https://api.coingecko.com/api/v3/ping' },
    { name: 'ExchangeRate', url: 'https://open.er-api.com/v6/latest/MYR' },
    { name: 'httpbin', url: 'https://httpbin.org/get' },
    { name: 'GitHub API', url: 'https://api.github.com/zen' },
    { name: 'RSS2JSON', url: 'https://api.rss2json.com/v1/api.json?rss_url=https://cointelegraph.com/rss&count=1' },
  ];

  el.innerHTML = '';
  for (const t of targets) {
    const row = document.createElement('div');
    row.className = 'alert-item';
    row.innerHTML = `<div class="info"><div class="coin">${t.name}</div><div class="cond">Testing…</div></div><span class="status active">…</span>`;
    el.appendChild(row);

    const start = performance.now();
    try {
      await fetch(t.url, { method: 'GET', mode: 'cors' });
      const ms = Math.round(performance.now() - start);
      row.querySelector('.cond').textContent = `${ms} ms · ${t.url.substring(0, 40)}…`;
      row.querySelector('.status').className = 'status triggered';
      row.querySelector('.status').textContent = '✅ REACHABLE';
      row.classList.add('triggered');
    } catch (e) {
      const ms = Math.round(performance.now() - start);
      row.querySelector('.cond').textContent = `${ms} ms · ${e.message.substring(0, 40)}`;
      row.querySelector('.status').className = 'status';
      row.querySelector('.status').style.background = 'rgba(239,68,68,0.15)';
      row.querySelector('.status').style.color = 'var(--red)';
      row.querySelector('.status').textContent = '❌ FAILED';
    }
  }
}

