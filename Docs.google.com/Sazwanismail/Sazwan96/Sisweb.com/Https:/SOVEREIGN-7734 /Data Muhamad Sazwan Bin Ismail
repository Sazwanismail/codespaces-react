  const container = document.getElementById('templates');
  if (filtered.length === 0) {
    container.innerHTML = '<p style="grid-column: 1/-1; text-align:center; color:#8b949e; padding:40px;">🔍 Tiada templat dijumpai.</p>';
  } else {
    container.innerHTML = filtered.map(t => `
