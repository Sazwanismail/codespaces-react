// ═══════════════════════════════════════════════════════════════════════════
// MODULE: AI INSIGHTS
// ═══════════════════════════════════════════════════════════════════════════

function computeMomentum(change24h, change7d) {
  return (change24h * 0.6) + (change7d * 0.4);
}

function getInsight(coin, data, spark) {
  const c24 = data.usd_24h_change || 0;
  const c7 = spark?.change7d || c24 * 1.8;
  const momentum = computeMomentum(c24, c7);
  const vol = Math.abs(c24);

  let tag, cls, title, body;
  if (momentum > 5) {
    tag = 'STRONG BULLISH'; cls = 'bull';
    title = `${coin.name} momentum positif kuat`;
    body = `Harga ${coin.symbol} naik <strong>${c24.toFixed(2)}%</strong> dalam 24 jam. Aliran jangka pendek <strong>bullish</strong>. Volume dagangan menunjukkan minat beli berterusan.`;
  } else if (momentum > 1.5) {
    tag = 'MILD BULLISH'; cls = 'bull';
    title = `${coin.name} menunjukkan sedikit kenaikan`;
    body = `Pergerakan positif <strong>${c24.toFixed(2)}%</strong> dengan momentum sederhana. Perhatikan tahap sokongan sebelum membuat keputusan.`;
  } else if (momentum < -5) {
    tag = 'STRONG BEARISH'; cls = 'bear';
    title = `${coin.name} dalam tekanan jualan`;
    body = `Harga turun <strong>${Math.abs(c24).toFixed(2)}%</strong>. Waspada — aliran menurun mungkin berterusan jika volume kekal tinggi.`;
  } else if (momentum < -1.5) {
    tag = 'MILD BEARISH'; cls = 'bear';
    title = `${coin.name} sedikit menurun`;
    body = `Penurunan <strong>${Math.abs(c24).toFixed(2)}%</strong>. Perhatikan paras sokongan terdekat.`;
  } else {
    tag = 'NEUTRAL'; cls = 'neutral';
    title = `${coin.name} stabil / sideways`;
    body = `Pergerakan kecil <strong>${c24.toFixed(2)}%</strong>. Pasaran mungkin sedang konsolidasi.`;
  }

  const confidence = Math.min(95, Math.max(35, Math.abs(momentum) * 12 + vol * 2));
  return { tag, cls, title, body, confidence, momentum, c24 };
}

async function runAIInsights() {
  const el = document.getElementById('ai-insights');
  const momBody = document.getElementById('ai-momentum-body');
  el.innerHTML = '<div class="loading"><div class="spinner"></div> Menganalisis pasaran…</div>';

  if (!STATE.crypto || Object.keys(STATE.crypto).length === 0) {
    await fetchCrypto();
  }

  const insights = [];
  const rankings = [];
  let bullCount = 0, bearCount = 0, totalVol = 0;

  for (const coin of CONFIG.cryptos) {
    const d = STATE.crypto[coin.id];
    if (!d) continue;
    const ins = getInsight(coin, d, null);
    insights.push({ coin, ...ins });
    rankings.push({ coin, d, momentum: ins.momentum });
    if (ins.momentum > 1.5) bullCount++;
    else if (ins.momentum < -1.5) bearCount++;
    totalVol += Math.abs(d.usd_24h_change || 0);
  }

  // Sort insights by absolute momentum
  insights.sort((a, b) => Math.abs(b.momentum) - Math.abs(a.momentum));

  el.innerHTML = insights.slice(0, 6).map(i => `
    <div class="insight-card ${i.cls}">
      <div class="head">
        <span class="title">${i.title}</span>
        <span class="tag ${i.cls}">${i.tag}</span>
      </div>
      <div class="body">${i.body}</div>
      <div class="conf-bar"><div style="width:${i.confidence}%"></div></div>
      <div class="conf-lbl">Confidence: ${i.confidence.toFixed(0)}%</div>
    </div>
  `).join('');

  // Momentum ranking table
  rankings.sort((a, b) => b.momentum - a.momentum);
  momBody.innerHTML = rankings.map((r, i) => {
    const c24 = r.d.usd_24h_change || 0;
    const c7 = c24 * 1.8;
    const momColor = r.momentum > 0 ? 'var(--green)' : 'var(--red)';
    return `<tr>
      <td style="color:var(--muted);">${i+1}</td>
      <td style="color:${r.coin.color};font-weight:800;">${r.coin.symbol}</td>
      <td style="color:var(--primary);">$${r.d.usd.toLocaleString('en-US',{maximumFractionDigits:2})}</td>
      <td style="color:${c24 >= 0 ? 'var(--green)' : 'var(--red)'};">${c24 >= 0 ? '+' : ''}${c24.toFixed(2)}%</td>
      <td style="color:${c7 >= 0 ? 'var(--green)' : 'var(--red)'};">${c7 >= 0 ? '+' : ''}${c7.toFixed(2)}%</td>
      <td style="color:${momColor};font-weight:800;">${r.momentum.toFixed(2)}</td>
    </tr>`;
  }).join('');

  // KPIs
  const avgVol = totalVol / insights.length;
  const volIndex = Math.min(100, avgVol * 6);
  const mood = bullCount > bearCount * 1.5 ? '🚀 BULLISH'
              : bearCount > bullCount * 1.5 ? '📉 BEARISH'
              : bullCount > bearCount ? '📈 LEANING BULL'
              : bearCount > bullCount ? '📉 LEANING BEAR'
              : '⚖️ NEUTRAL';

  document.getElementById('ai-bull').textContent = bullCount;
  document.getElementById('ai-bear').textContent = bearCount;
  document.getElementById('ai-vol').textContent = volIndex.toFixed(0);
  document.getElementById('ai-mood').textContent = mood;

  showToast('AI Insights Ready', `${insights.length} coins analysed`, 'success');
}

