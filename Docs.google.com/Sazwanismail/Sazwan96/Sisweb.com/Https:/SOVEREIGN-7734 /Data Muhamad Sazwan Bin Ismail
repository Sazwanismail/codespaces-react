function generatePassword() {
  const len = parseInt(document.getElementById('pwd-len').value) || 20;
  let chars = '';
  if (document.getElementById('pwd-upper').checked) chars += 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';
  if (document.getElementById('pwd-lower').checked) chars += 'abcdefghijklmnopqrstuvwxyz';
  if (document.getElementById('pwd-num').checked) chars += '0123456789';
  if (document.getElementById('pwd-sym').checked) chars += '!@#$%^&*()_+-=[]{}|;:,.<>?';

  if (!chars) {
    showToast('Ralat', 'Pilih sekurang-kurangnya satu jenis aksara', 'warning');
    return;
  }

  const arr = new Uint32Array(len);
  crypto.getRandomValues(arr);
  let pwd = '';
  for (let i = 0; i < len; i++) pwd += chars[arr[i] % chars.length];

  document.getElementById('pwd-val').textContent = pwd;
  document.getElementById('pwd-val').style.color = 'var(--cyan)';

  // Strength
  let score = 0;
  if (len >= 12) score++;
  if (len >= 20) score++;
  if (/[A-Z]/.test(pwd) && /[a-z]/.test(pwd)) score++;
  if (/[0-9]/.test(pwd)) score++;
  if (/[^A-Za-z0-9]/.test(pwd)) score++;
  score = Math.min(4, score);

  const segs = ['s1','s2','s3','s4'];
  const cls = score >= 4 ? 'strong' : score >= 3 ? 'good' : score >= 2 ? 'fair' : 'weak';
  const lbl = score >= 4 ? 'Sangat Kuat' : score >= 3 ? 'Kuat' : score >= 2 ? 'Sederhana' : 'Lemah';

  segs.forEach((id, i) => {
    const el = document.getElementById(id);
    el.className = 'seg' + (i < score ? ' ' + cls : '');
  });
  document.getElementById('pwd-strength').textContent = 'Strength: ' + lbl + ' (' + score + '/4)';
}

async function generateHashes() {
  const input = document.getElementById('hash-input').value || '';
  const el = document.getElementById('hash-output');
  if (!input) { showToast('Ralat', 'Masukkan teks untuk di-hash', 'warning'); return; }

  const enc = new TextEncoder();
  const buf = enc.encode(input);
  const hashBuf = await crypto.subtle.digest('SHA-256', buf);
  const sha256 = Array.from(new Uint8Array(hashBuf)).map(b => b.toString(16).padStart(2, '0')).join('');

  const hashBuf512 = await crypto.subtle.digest('SHA-512', buf);
  const sha512 = Array.from(new Uint8Array(hashBuf512)).map(b => b.toString(16).padStart(2, '0')).join('');

  const b64 = btoa(unescape(encodeURIComponent(input)));
  const b64url = b64.replace(/\+/g,'-').replace(/\//g,'_').replace(/=+$/,'');

  el.innerHTML = `
    <div class="hash-row"><span class="k">SHA-256</span><span class="v">${sha256}</span></div>
    <div class="hash-row"><span class="k">SHA-512</span><span class="v">${sha512.substring(0,80)}…</span></div>
    <div class="hash-row"><span class="k">Base64</span><span class="v">${b64}</span></div>
    <div class="hash-row"><span class="k">Base64 URL</span><span class="v">${b64url}</span></div>
    <div class="hash-row"><span class="k">Length</span><span class="v">${input.length} chars</span></div>
  `;
}

function generateUUID(bulk = 1) {
  const vals = [];
  for (let i = 0; i < bulk; i++) {
    vals.push(crypto.randomUUID());
  }
  document.getElementById('uuid-val').textContent = vals.join('\n');
  document.getElementById('uuid-val').style.whiteSpace = 'pre-line';
  document.getElementById('uuid-val').style.color = 'var(--cyan)';
}

function copyText(txt) {
  if (!txt || txt === '--') return;
  navigator.clipboard.writeText(txt).then(() => showToast('Copied', 'Teks disalin ke clipboard', 'success'))
    .catch(() => showToast('Gagal', 'Clipboard tidak dibenarkan', 'warning'));
}

