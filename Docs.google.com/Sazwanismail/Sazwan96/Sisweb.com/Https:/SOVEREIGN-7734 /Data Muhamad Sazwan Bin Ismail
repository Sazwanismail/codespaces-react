let analysisChart = null;
const DIAG_KEY = 'sgae_diagnostics';

function anaLog(msg, type = 'info') {
  const el = document.getElementById('ana-log');
  if (!el) return;
  const time = new Date().toLocaleTimeString('ms-MY', { hour12: false });
  const cls = { ok: 'l-ok', warn: 'l-warn', err: 'l-err', info: 'l-info' }[type] || 'l-info';
  const line = document.createElement('div');
  line.innerHTML = `<span class="l-time">[${time}]</span> <span class="${cls}">${msg}</span>`;
  el.appendChild(line);
  el.scrollTop = el.scrollHeight;
  if (el.children.length > 120) el.removeChild(el.firstChild);

  try {
    const log = JSON.parse(localStorage.getItem(DIAG_KEY) || '[]');
    log.push({ t: Date.now(), msg, type });
    if (log.length > 200) log.splice(0, log.length - 200);
    localStorage.setItem(DIAG_KEY, JSON.stringify(log));
  } catch {}
}

function clearDiagnostics() {
  document.getElementById('ana-log').innerHTML = '<div><span class="l-time">[reset]</span> <span class="l-info">Log dibersihkan.</span></div>';
  localStorage.removeItem(DIAG_KEY);
}

async function runFullAnalysis() {
  anaLog('Analysis run started', 'info');
  const circle = document.getElementById('score-circle');
  const num = document.getElementById('score-num');

  // 1) Navigation Timing
  const nav = performance.getEntriesByType('navigation')[0] || {};
  const navData = [
    { k: 'DNS Lookup', v: Math.round(nav.domainLookupEnd - nav.domainLookupStart || 0), u: 'ms', limit: 100 },
    { k: 'TCP Connect', v: Math.round(nav.connectEnd - nav.connectStart || 0), u: 'ms', limit: 150 },
    { k: 'TTFB', v: Math.round(nav.responseStart - nav.requestStart || 0), u: 'ms', limit: 400 },
    { k: 'DOM Loaded', v: Math.round(nav.domContentLoadedEventEnd - nav.startTime || 0), u: 'ms', limit: 1500 },
    { k: 'Full Load', v: Math.round(nav.loadEventEnd - nav.startTime || 0), u: 'ms', limit: 3000 },
  ];
  document.getElementById('ana-nav').innerHTML = navData.map(d => {
    const cls = d.v < d.limit ? 'good' : d.v < d.limit * 2 ? 'warn' : 'bad';
    return `<div class="metric-row"><span class="k">${d.k}</span><span class="v ${cls}">${d.v} ${d.u}</span></div>`;
  }).join('');

  // 2) Paint
  const paints = performance.getEntriesByType('paint');
  const fp = paints.find(p => p.name === 'first-paint');
  const fcp = paints.find(p => p.name === 'first-contentful-paint');
  document.getElementById('ana-paint').innerHTML = `
    <div class="metric-row"><span class="k">First Paint</span><span class="v ${fp && fp.startTime < 800 ? 'good' : 'warn'}">${fp ? Math.round(fp.startTime) + ' ms' : '--'}</span></div>
    <div class="metric-row"><span class="k">First Contentful Paint</span><span class="v ${fcp && fcp.startTime < 1500 ? 'good' : 'warn'}">${fcp ? Math.round(fcp.startTime) + ' ms' : '--'}</span></div>
    <div class="metric-row"><span class="k">Document Ready</span><span class="v good">${document.readyState}</span></div>
  `;

  // 3) Memory
  const mem = performance.memory || {};
  if (mem.usedJSHeapSize) {
    const used = (mem.usedJSHeapSize / 1048576).toFixed(1);
    const total = (mem.totalJSHeapSize / 1048576).toFixed(1);
    const limit = (mem.jsHeapSizeLimit / 1048576).toFixed(0);
    const pct = (mem.usedJSHeapSize / mem.jsHeapSizeLimit) * 100;
    document.getElementById('ana-mem').innerHTML = `
      <div class="metric-row"><span class="k">Used Heap</span><span class="v ${pct < 50 ? 'good' : pct < 80 ? 'warn' : 'bad'}">${used} MB</span></div>
      <div class="metric-row"><span class="k">Total Heap</span><span class="v">${total} MB</span></div>
      <div class="metric-row"><span class="k">Heap Limit</span><span class="v">${limit} MB</span></div>
      <div class="metric-row"><span class="k">Usage</span><span class="v ${pct < 50 ? 'good' : 'warn'}">${pct.toFixed(1)}%</span></div>
    `;
  } else {
    document.getElementById('ana-mem').innerHTML = `<div class="loading" style="font-size:0.7rem;">Memory API tidak disokong pelayar ini.</div>`;
  }

  // 4) API Health
  const apis = [
    { k: 'CoinGecko', v: STATE.health.coingecko },
    { k: 'ExchangeRate', v: STATE.health.exchangerate },
    { k: 'Weather', v: STATE.health.weather },
    { k: 'News', v: STATE.health.news },
    { k: 'IP API', v: STATE.health.ipapi },
  ];
  document.getElementById('ana-api').innerHTML = apis.map(a => {
    const lat = a.v?.latency || 0;
    const st = a.v?.status || 'wait';
    const cls = st === 'error' ? 'bad' : lat < 300 ? 'good' : lat < 800 ? 'warn' : 'bad';
    return `<div class="metric-row"><span class="k">${a.k}</span><span class="v ${cls}">${lat ? lat + ' ms' : (st === 'error' ? 'ERROR' : '--')}</span></div>`;
  }).join('');

  // 5) Compute overall score
  const latencies = apis.map(a => a.v?.latency || 0).filter(v => v > 0);
  const avgLat = latencies.length ? latencies.reduce((a, b) => a + b, 0) / latencies.length : 9999;
  const latencyScore = Math.max(0, Math.min(100, 100 - avgLat / 15));

  const loadScore = Math.max(0, Math.min(100, 100 - ((nav.loadEventEnd - nav.startTime) || 9999) / 40));
  const apiOk = apis.filter(a => a.v?.status === 'ok').length / apis.length * 100;
  const onlineScore = navigator.onLine ? 100 : 0;

  const score = Math.round(latencyScore * 0.35 + loadScore * 0.25 + apiOk * 0.25 + onlineScore * 0.15);

  // Animate circle
  const deg = score * 3.6;
  const color = score >= 80 ? 'var(--green)' : score >= 55 ? 'var(--gold)' : 'var(--red)';
  circle.style.background = `conic-gradient(${color} ${deg}deg, var(--border) ${deg}deg)`;
  num.textContent = score;
  num.style.color = color;

  document.getElementById('score-desc').innerHTML = `
    <strong style="color:${color};font-size:1rem;">Skor: ${score}/100</strong><br>
    Avg API Latency: <strong>${Math.round(avgLat)} ms</strong> ·
    Page Load: <strong>${Math.round((nav.loadEventEnd - nav.startTime) || 0)} ms</strong><br>
    APIs Sehat: <strong>${apis.filter(a => a.v?.status === 'ok').length}/${apis.length}</strong> ·
    Status: <strong style="color:${onlineScore ? 'var(--green)' : 'var(--red)'};">${navigator.onLine ? 'ONLINE' : 'OFFLINE'}</strong>
  `;

  anaLog(`Score computed: ${score}/100 (avgLatency ${Math.round(avgLat)}ms)`, score >= 80 ? 'ok' : score >= 55 ? 'warn' : 'err');

  // 6) Analysis chart
  updateAnalysisChart(apis);

  showToast('Analysis Complete', `Health score: ${score}/100`, score >= 55 ? 'success' : 'warning');
}

function updateAnalysisChart(apis) {
  const ctx = document.getElementById('chart-analysis');
  if (!ctx) return;
  const dim = getComputedStyle(document.body).getPropertyValue('--dim');
  const brd = getComputedStyle(document.body).getPropertyValue('--border');

  if (analysisChart) analysisChart.destroy();
  analysisChart = new Chart(ctx, {
    type: 'doughnut',
    data: {
      labels: apis.map(a => a.k),
      datasets: [{
        data: apis.map(a => a.v?.latency || 0),
        backgroundColor: ['#8dc647','#0ea5e9','#f59e0b','#a78bfa','#22d3ee','#f472b6'],
        borderWidth: 0,
      }]
    },
    options: {
      responsive: true, maintainAspectRatio: false,
      plugins: {
        legend: { position: 'right', labels: { color: dim, font: { size: 11 } } },
        tooltip: { callbacks: { label: c => `${c.label}: ${c.raw} ms` } }
      }
    }
  });
}

