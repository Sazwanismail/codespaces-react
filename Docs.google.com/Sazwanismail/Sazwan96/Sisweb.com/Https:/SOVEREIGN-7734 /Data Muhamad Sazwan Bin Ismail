// MODULE: PORTFOLIO TRACKER
// ═══════════════════════════════════════════════════════════════════════════

const PORT_KEY = 'sgae_portfolio';
let portfolioChart = null;

function loadPortfolio() {
  try { return JSON.parse(localStorage.getItem(PORT_KEY) || '[]'); }
  catch { return []; }
}

function savePortfolio(p) {
  localStorage.setItem(PORT_KEY, JSON.stringify(p));
}

function addHolding() {
  const coinId = document.getElementById('port-coin').value;
  const amount = parseFloat(document.getElementById('port-amount').value);
  const buy = parseFloat(document.getElementById('port-buy').value);

  if (!amount || amount <= 0 || !buy || buy <= 0) {
    showToast('Ralat', 'Masukkan jumlah dan harga beli yang sah', 'warning');
    return;
  }

  const p = loadPortfolio();
  p.push({ id: Date.now(), coinId, amount, buy, addedAt: new Date().toISOString() });
  savePortfolio(p);

  document.getElementById('port-amount').value = '';
  document.getElementById('port-buy').value = '';

  renderPortfolio();
  showToast('Holding Added', `${amount} × ${coinId}`, 'success');
}

function deleteHolding(id) {
  const p = loadPortfolio().filter(h => h.id !== id);
  savePortfolio(p);
  renderPortfolio();
}

function clearPortfolio() {
  if (!confirm('Padam semua holdings?')) return;
  savePortfolio([]);
  renderPortfolio();
}

function renderPortfolio() {
  const p = loadPortfolio();
  const tbody = document.getElementById('port-body');

  if (p.length === 0) {
    tbody.innerHTML = '<tr><td colspan="8" style="text-align:center;padding:2rem;color:var(--dim);">Tiada holdings. Tambah di atas.</td></tr>';
    document.getElementById('port-total').textContent = '$0';
    document.getElementById('port-cost').textContent = '$0';
    document.getElementById('port-pnl').textContent = '$0';
    document.getElementById('port-pnl-pct').textContent = '0%';
    document.getElementById('port-holdings').textContent = '0';
    if (portfolioChart) portfolioChart.destroy();
    return;
  }

  let totalValue = 0, totalCost = 0;
  const alloc = {};

  tbody.innerHTML = p.map(h => {
    const coin = CONFIG.cryptos.find(c => c.id === h.coinId);
    const price = STATE.crypto[h.coinId]?.usd || 0;
    const value = price * h.amount;
    const cost = h.buy * h.amount;
    const pnl = value - cost;
    const pnlPct = cost > 0 ? (pnl / cost) * 100 : 0;
    totalValue += value;
    totalCost += cost;
    alloc[coin?.symbol || h.coinId] = (alloc[coin?.symbol || h.coinId] || 0) + value;

    const cls = pnl >= 0 ? 'var(--green)' : 'var(--red)';
    return `<tr>
      <td style="color:${coin?.color || 'var(--primary)'};font-weight:800;">${coin?.symbol || h.coinId}</td>
      <td>${h.amount}</td>
      <td>$${h.buy.toLocaleString()}</td>
      <td style="color:var(--primary);">$${price.toLocaleString('en-US',{maximumFractionDigits:2})}</td>
      <td>$${value.toLocaleString('en-US',{maximumFractionDigits:2})}</td>
      <td style="color:${cls};font-weight:800;">${pnl >= 0 ? '+' : ''}$${pnl.toFixed(2)}</td>
      <td style="color:${cls};">${pnlPct >= 0 ? '+' : ''}${pnlPct.toFixed(2)}%</td>
      <td><button class="btn danger" onclick="deleteHolding(${h.id})" style="padding:4px 8px;font-size:0.6rem;"><i class="fas fa-trash"></i></button></td>
    </tr>`;
  }).join('');

  const totalPnl = totalValue - totalCost;
  const totalPnlPct = totalCost > 0 ? (totalPnl / totalCost) * 100 : 0;

  document.getElementById('port-total').textContent = '$' + totalValue.toLocaleString('en-US',{maximumFractionDigits:2});
  document.getElementById('port-cost').textContent = '$' + totalCost.toLocaleString('en-US',{maximumFractionDigits:2});
  document.getElementById('port-pnl').textContent = (totalPnl >= 0 ? '+' : '') + '$' + totalPnl.toFixed(2);
  document.getElementById('port-pnl').style.color = totalPnl >= 0 ? 'var(--green)' : 'var(--red)';
  document.getElementById('port-pnl-pct').textContent = (totalPnlPct >= 0 ? '+' : '') + totalPnlPct.toFixed(2) + '%';
  document.getElementById('port-pnl-pct').style.color = totalPnlPct >= 0 ? 'var(--green)' : 'var(--red)';
  document.getElementById('port-holdings').textContent = p.length;
  document.getElementById('port-pnl-cell').className = 'port-cell ' + (totalPnl >= 0 ? 'up' : 'down');

  // Chart
  const ctx = document.getElementById('chart-portfolio');
  if (!ctx) return;
  const dim = getComputedStyle(document.body).getPropertyValue('--dim');
  if (portfolioChart) portfolioChart.destroy();
  portfolioChart = new Chart(ctx, {
    type: 'doughnut',
    data: {
      labels: Object.keys(alloc),
      datasets: [{
        data: Object.values(alloc),
        backgroundColor: ['#f7931a','#627eea','#14f195','#0033ad','#e6007a','#c2a633','#23292f','#2a5ada'],
        borderWidth: 0,
      }]
    },
    options: {
      responsive: true, maintainAspectRatio: false,
      plugins: {
        legend: { position: 'right', labels: { color: dim, font: { size: 11 } } },
        tooltip: { callbacks: { label: c => `${c.label}: $${c.raw.toLocaleString()}` } }
      }
    }
  });
}

