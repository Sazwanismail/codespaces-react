const LIVE = {
  samples: [],
  timeline: [],
  maxSamples: 30,
  startTime: Date.now(),
  interval: null,
  chart: null,
};

function liveLog(msg, type = 'info') {
  const el = document.getElementById('live-log');
  if (!el) return;
  const time = new Date().toLocaleTimeString('ms-MY', { hour12: false });
  const cls = { ok: 'l-ok', warn: 'l-warn', err: 'l-err', info: 'l-info' }[type] || 'l-info';
  const line = document.createElement('div');
  line.innerHTML = `<span class="l-time">[${time}]</span> <span class="${cls}">${msg}</span>`;
  el.appendChild(line);
  el.scrollTop = el.scrollHeight;
  if (el.children.length > 100) el.removeChild(el.firstChild);
}

const PING_TARGETS = [
  { name: 'CoinGecko', url: 'https://api.coingecko.com/api/v3/ping', color: '#8dc647' },
  { name: 'Cloudflare', url: 'https://1.1.1.1/cdn-cgi/trace', color: '#f6821f' },
  { name: 'GitHub', url: 'https://api.github.com/zen', color: '#a78bfa' },
  { name: 'ExchangeRate', url: 'https://open.er-api.com/v6/latest/MYR', color: '#22d3ee' },
];

async function pingTarget(t) {
  const start = performance.now();
  try {
    await fetch(t.url + (t.url.includes('?') ? '&' : '?') + '_=' + Date.now(), { cache: 'no-store' });
    return Math.round(performance.now() - start);
  } catch {
    return null;
  }
}

async function runLivePing() {
  const container = document.getElementById('live-pings');
  if (!container) return;
  container.innerHTML = '';

  let totalMs = 0, okCount = 0;

  for (const t of PING_TARGETS) {
    const ms = await pingTarget(t);
    const row = document.createElement('div');
    row.className = 'ping-row';

    if (ms !== null) {
      totalMs += ms; okCount++;
      const pct = Math.max(5, Math.min(100, 100 - ms / 10));
      const color = ms < 200 ? 'var(--green)' : ms < 600 ? 'var(--gold)' : 'var(--red)';
      const status = ms < 200 ? 'FAST' : ms < 600 ? 'OK' : 'SLOW';
      row.innerHTML = `
        <span class="name" style="color:${t.color};">${t.name}</span>
        <div class="bar-wrap"><div style="width:${pct}%;background:${color};"></div></div>
        <span class="ms" style="color:${color};">${ms} ms</span>
        <span class="st" style="color:${color};">${status}</span>
      `;
    } else {
      row.innerHTML = `
        <span class="name" style="color:${t.color};">${t.name}</span>
        <div class="bar-wrap"><div style="width:5%;background:var(--red);"></div></div>
        <span class="ms" style="color:var(--red);">-- </span>
        <span class="st" style="color:var(--red);">FAIL</span>
      `;
    }
    container.appendChild(row);
  }

  const avg = okCount > 0 ? Math.round(totalMs / okCount) : 0;
  LIVE.samples.push(avg);
  if (LIVE.samples.length > 10) LIVE.samples.shift();

  const rolling = Math.round(LIVE.samples.reduce((a, b) => a + b, 0) / LIVE.samples.length);
  document.getElementById('live-latency').textContent = rolling + ' ms';
  document.getElementById('live-samples').textContent = LIVE.timeline.length + ' samples';
  document.getElementById('live-status').textContent = navigator.onLine ? 'ONLINE' : 'OFFLINE';
  document.getElementById('live-status').style.color = navigator.onLine ? 'var(--green)' : 'var(--red)';

  const conn = navigator.connection || {};
  document.getElementById('live-type').textContent = (conn.effectiveType || 'unknown').toUpperCase() + ' · ' + (conn.downlink ? conn.downlink + ' Mbps' : '--');
  document.getElementById('live-downlink').textContent = (conn.downlink || 0).toFixed(1) + ' Mbps';

  // Uptime
  const secs = Math.floor((Date.now() - LIVE.startTime) / 1000);
  const mm = String(Math.floor(secs / 60)).padStart(2, '0');
  const ss = String(secs % 60).padStart(2, '0');
  document.getElementById('live-uptime').textContent = mm + ':' + ss;

  // Timeline
  LIVE.timeline.push({ t: Date.now(), v: avg });
  if (LIVE.timeline.length > LIVE.maxSamples) LIVE.timeline.shift();
  updateLiveChart();
}

function updateLiveChart() {
  const ctx = document.getElementById('chart-live-latency');
  if (!ctx) return;
  const dim = getComputedStyle(document.body).getPropertyValue('--dim');
  const brd = getComputedStyle(document.body).getPropertyValue('--border');

  if (LIVE.chart) LIVE.chart.destroy();
  LIVE.chart = new Chart(ctx, {
    type: 'line',
    data: {
      labels: LIVE.timeline.map(s => new Date(s.t).toLocaleTimeString('ms-MY', { hour12: false })),
      datasets: [{
        label: 'Avg Latency (ms)',
        data: LIVE.timeline.map(s => s.v),
        borderColor: '#22d3ee',
        backgroundColor: 'rgba(34,211,238,0.15)',
        tension: 0.35,
        borderWidth: 2,
        pointRadius: 2,
        fill: true,
      }]
    },
    options: {
      responsive: true, maintainAspectRatio: false,
      animation: { duration: 300 },
      plugins: { legend: { labels: { color: dim } } },
      scales: {
        x: { ticks: { color: dim, maxTicksLimit: 8 }, grid: { color: brd } },
        y: { ticks: { color: dim }, grid: { color: brd }, beginAtZero: true }
      }
    }
  });
}

function startLiveMonitor() {
  runLivePing();
  LIVE.interval = setInterval(runLivePing, 5000);

  window.addEventListener('online', () => {
    liveLog('Connection RESTORED', 'ok');
    runLivePing();
  });
  window.addEventListener('offline', () => liveLog('Connection LOST', 'err'));

  const conn = navigator.connection;
  if (conn && conn.addEventListener) {
    conn.addEventListener('change', () => {
      liveLog(`Network changed → ${conn.effectiveType} @ ${conn.downlink} Mbps`, 'info');
      runLivePing();
    });
  }
}

