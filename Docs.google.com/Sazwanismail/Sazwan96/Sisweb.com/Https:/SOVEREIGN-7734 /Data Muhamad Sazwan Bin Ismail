function initConverter() {
  const from = document.getElementById('conv-from');
  const to = document.getElementById('conv-to');
  const opts = CONFIG.cryptos.map(c => `<option value="${c.id}">${c.symbol}</option>`).join('');
  const fiatOpts = CONFIG.fiat.map(f => `<option value="${f}">${f}</option>`).join('');
  from.innerHTML = opts + fiatOpts;
  to.innerHTML = opts + fiatOpts;
  from.value = 'bitcoin';
  to.value = 'USD';
  from.addEventListener('change', runConverter);
  to.addEventListener('change', runConverter);
  document.getElementById('conv-amount').addEventListener('input', runConverter);
}

function swapConverter() {
  const f = document.getElementById('conv-from');
  const t = document.getElementById('conv-to');
  const tmp = f.value; f.value = t.value; t.value = tmp;
  runConverter();
}

async function runConverter() {
  const amount = parseFloat(document.getElementById('conv-amount').value) || 0;
  const from = document.getElementById('conv-from').value;
  const to = document.getElementById('conv-to').value;

  let usdFrom = 0, usdTo = 0;

  // From crypto?
  if (STATE.crypto[from]) usdFrom = STATE.crypto[from].usd;
  else {
    // Fiat: from MYR base API
    const rate = STATE.fiat[from];
    if (rate) usdFrom = 1 / (STATE.fiat.USD * rate); // approximate
    // Simpler: if USD exists
    if (from === 'USD') usdFrom = 1;
    else if (STATE.fiat.USD) usdFrom = STATE.fiat.USD / (STATE.fiat[from] || 1);
  }

  if (STATE.crypto[to]) usdTo = STATE.crypto[to].usd;
  else {
    if (to === 'USD') usdTo = 1;
    else if (STATE.fiat.USD) usdTo = STATE.fiat.USD / (STATE.fiat[to] || 1);
  }

  // Recalculate more reliably
  let result = 0;
  const getUSD = (code) => {
    if (STATE.crypto[code]) return STATE.crypto[code].usd;
    if (code === 'USD') return 1;
    const r = STATE.fiat[code];
    // STATE.fiat is MYR base: 1 MYR = r CODE. So 1 CODE = 1/r MYR
    // USD: 1 MYR = fiat.USD USD, so 1 USD = 1/fiat.USD MYR
    // 1 CODE = (1/r) MYR = (1/r) * fiat.USD USD
    if (r && STATE.fiat.USD) return STATE.fiat.USD / r;
    return 0;
  };

  usdFrom = getUSD(from);
  usdTo = getUSD(to);

  if (usdFrom > 0 && usdTo > 0) result = (amount * usdFrom) / usdTo;

  document.getElementById('conv-result').value = result.toFixed(6);
  document.getElementById('conv-display').textContent = `${result.toLocaleString('en-US',{maximumFractionDigits: 6})} ${to.toUpperCase()}`;
  document.getElementById('conv-rate').textContent = `1 ${from.toUpperCase()} = ${((usdFrom)/usdTo).toFixed(6)} ${to.toUpperCase()}`;
}

async function fetchGas() {
  const el = document.getElementById('gas-info');
  el.innerHTML = '<div class="loading">Loading…</div>';
  try {
    // Use Etherscan-like free public API — but no key. Fallback: use public RPC gas price
    const r = await fetch('https://eth.llamarpc.com', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ jsonrpc: '2.0', method: 'eth_gasPrice', params: [], id: 1 })
    });
    const d = await r.json();
    const wei = parseInt(d.result, 16);
    const gwei = wei / 1e9;

    const ethPrice = STATE.crypto.ethereum?.usd || 0;
    const txCost = (gwei * 21000 * 1e-9) * ethPrice;
    const swapCost = (gwei * 150000 * 1e-9) * ethPrice;

    const level = gwei < 20 ? 'good' : gwei < 50 ? 'warn' : 'bad';
    el.innerHTML = `
      <div class="analysis-card" style="margin-bottom:0.6rem;">
        <h4><i class="fas fa-gas-pump"></i> Current Base Fee</h4>
        <div class="metric-row"><span class="k">Gas Price</span><span class="v ${level}">${gwei.toFixed(2)} Gwei</span></div>
        <div class="metric-row"><span class="k">Simple Transfer (21k)</span><span class="v">$${txCost.toFixed(4)}</span></div>
        <div class="metric-row"><span class="k">Token Swap (150k)</span><span class="v">$${swapCost.toFixed(3)}</span></div>
        <div class="metric-row"><span class="k">ETH Price</span><span class="v">$${ethPrice.toLocaleString()}</span></div>
