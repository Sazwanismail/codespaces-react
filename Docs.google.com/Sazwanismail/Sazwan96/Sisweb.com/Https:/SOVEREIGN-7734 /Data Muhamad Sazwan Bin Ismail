async function checkForUpdates() {
  const el = document.getElementById('ver-status');
  el.innerHTML = `<i class="fas fa-spinner fa-spin"></i> Menyemak kemas kini…`;

  try {
    // Check GitHub releases (gantikan username/repo dengan milik anda)
    const r = await fetch('https://api.github.com/repos/Sazwanismail/sgae-data-lake/releases/latest', {
      headers: { 'Accept': 'application/vnd.github+json' }
    }).catch(() => null);

    let latest = null;
    if (r && r.ok) {
      const d = await r.json();
      latest = d.tag_name || null;
    }

    if (!latest) {
      document.getElementById('ver-latest').textContent = 'v3.0.1';
      document.getElementById('ver-latest').style.color = 'var(--green)';
      el.innerHTML = `<i class="fas fa-circle-check" style="color:var(--green);"></i> Anda menggunakan versi terkini (<code>${APP_VERSION.current}</code>). GitHub repo tidak dijumpai — dianggap tiada kemas kini.`;
    } else if (latest === APP_VERSION.current) {
      document.getElementById('ver-latest').textContent = latest;
      document.getElementById('ver-latest').style.color = 'var(--green)';
      el.innerHTML = `<i class="fas fa-circle-check" style="color:var(--green);"></i> Sistem dikemas kini. Versi terkini: <code>${latest}</code>`;
    } else {
      document.getElementById('ver-latest').textContent = latest;
      document.getElementById('ver-latest').style.color = 'var(--gold)';
      el.innerHTML = `<i class="fas fa-triangle-exclamation" style="color:var(--gold);"></i> Versi baharu tersedia: <code>${latest}</code> (anda: <code>${APP_VERSION.current}</code>). Klik <strong>Force Refresh</strong> untuk muat semula.`;
    }
    document.getElementById('ver-check-time').textContent = 'Checked: ' + new Date().toLocaleTimeString('ms-MY');
  } catch (e) {
    el.innerHTML = `<i class="fas fa-circle-info"></i> Semakan gagal: ${e.message}. Guna <strong>Force Refresh</strong> sebagai alternatif.`;
  }

  renderStorageTable();
}

async function applyPWAUpdate() {
  try {
    if ('serviceWorker' in navigator) {
      const regs = await navigator.serviceWorker.getRegistrations();
      for (const r of regs) await r.unregister();
    }
    if ('caches' in window) {
      const keys = await caches.keys();
      await Promise.all(keys.map(k => caches.delete(k)));
    }
    showToast('Cache Cleared', 'Memuat semula dashboard…', 'success');
    setTimeout(() => location.reload(true), 900);
  } catch (e) {
    showToast('Update Gagal', e.message, 'danger');
  }
}

function renderStorageTable() {
  const tbody = document.getElementById('storage-table');
  if (!tbody) return;
  const keys = ['sgae_snapshots','sgae_alerts','sgae_alert_history','sgae_theme','sgae_api_keys','sgae_ledger'];
  const rows = keys.map(k => {
    const raw = localStorage.getItem(k);
    const size = raw ? new Blob([raw]).size : 0;
    let count = 0;
    try { const p = JSON.parse(raw); count = Array.isArray(p) ? p.length : (p ? Object.keys(p).length : 0); } catch {}
    const status = raw ? '<span class="ok">● STORED</span>' : '<span class="warn">○ EMPTY</span>';
    return `<tr>
      <td style="color:var(--primary);">${k}</td>
      <td>${size} B</td>
      <td>${count}</td>
      <td>${status}</td>
    </tr>`;
  }).join('');
  tbody.innerHTML = rows;

  document.getElementById('ver-current').textContent = APP_VERSION.current;
  document.getElementById('ver-build').textContent = 'Build: ' + APP_VERSION.build + ' · ' + APP_VERSION.channel;
}

