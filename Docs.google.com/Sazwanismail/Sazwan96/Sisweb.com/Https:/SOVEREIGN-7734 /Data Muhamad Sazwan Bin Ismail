function convertCurrency() {
  const amount = parseFloat(document.getElementById('convAmount').value) || 0;
  const from = document.getElementById('convFrom').value;
  const to = document.getElementById('convTo').value;
  
  if (!CURRENCY_DATA[from] || !CURRENCY_DATA[to]) return;
  
  const valueInMYR = amount / CURRENCY_DATA[from].rate;
  const converted = valueInMYR * CURRENCY_DATA[to].rate;
  
  const decimals = converted < 0.001 ? 8 : converted < 1 ? 6 : converted < 1000 ? 4 : 2;
  const formatted = converted.toLocaleString('en-US', { minimumFractionDigits: decimals, maximumFractionDigits: decimals });
  
  document.getElementById('convTarget').value = formatted;
  document.getElementById('convResult').textContent = `${formatted} ${to}`;
  document.getElementById('convRate').textContent = `1 ${from} = ${(CURRENCY_DATA[to].rate / CURRENCY_DATA[from].rate).toFixed(6)} ${to}`;
}

function swapCurrency() {
  const from = document.getElementById('convFrom').value;
  const to = document.getElementById('convTo').value;
  document.getElementById('convFrom').value = to;
  document.getElementById('convTo').value = from;
  convertCurrency();
}

function setAmount(v) {
  document.getElementById('convAmount').value = v;
  convertCurrency();
}

