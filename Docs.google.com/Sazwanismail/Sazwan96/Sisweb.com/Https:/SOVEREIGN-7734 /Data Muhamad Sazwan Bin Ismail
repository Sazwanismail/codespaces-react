let clockMode = 'all';

function setClockMode(evt, mode) {
  clockMode = mode;
  evt.currentTarget.parentElement.querySelectorAll('button').forEach(b => b.classList.remove('active'));
  evt.currentTarget.classList.add('active');
  renderClocks();
}

function renderClocks() {
  const grid = document.getElementById('clock-grid');
  if (!grid) return;

  let cities = CITIES;
  if (clockMode === 'major') cities = CITIES.filter(c => c.major);
  else if (clockMode === 'asia') cities = CITIES.filter(c => c.region === 'asia');

  const now = new Date();
  grid.innerHTML = cities.map(c => {
    const time = now.toLocaleTimeString('en-GB', { timeZone: c.tz, hour12: false });
    const date = now.toLocaleDateString('ms-MY', { timeZone: c.tz, day: '2-digit', month: 'short', year: 'numeric' });
    const hour = parseInt(time.split(':')[0]);
    const isDay = hour >= 6 && hour < 18;
    return `
      <div class="clock-card">
        <div class="city">${c.city}</div>
        <div class="tz">${c.tz}</div>
        <div class="time">${time}</div>
        <div class="date">${date}</div>
        <div class="daynight ${isDay ? 'day' : 'night'}">
          <i class="fas fa-${isDay ? 'sun' : 'moon'}"></i> ${isDay ? 'SIANG' : 'MALAM'}
        </div>
      </div>
    `;
  }).join('');
}

function renderMarketSessions() {
  const el = document.getElementById('market-sessions');
  if (!el) return;

  const sessions = [
    { name: 'Bursa Malaysia', open: '09:00', close: '17:00', tz: 'Asia/Kuala_Lumpur', flag: '🇲🇾' },
    { name: 'Nikkei (Tokyo)', open: '09:00', close: '15:00', tz: 'Asia/Tokyo', flag: '🇯🇵' },
    { name: 'HKEX', open: '09:30', close: '16:00', tz: 'Asia/Hong_Kong', flag: '🇭🇰' },
    { name: 'LSE (London)', open: '08:00', close: '16:30', tz: 'Europe/London', flag: '🇬🇧' },
    { name: 'NYSE (New York)', open: '09:30', close: '16:00', tz: 'America/New_York', flag: '🇺🇸' },
    { name: 'Crypto 24/7', open: '00:00', close: '23:59', tz: null, flag: '₿' },
  ];

  const now = new Date();
  el.innerHTML = sessions.map(s => {
    let isOpen = true;
    if (s.tz) {
      const fmt = new Intl.DateTimeFormat('en-GB', { timeZone: s.tz, hour: '2-digit', minute: '2-digit', hour12: false, weekday: 'short' });
      const parts = fmt.formatToParts(now);
      const time = parts.find(p => p.type === 'hour').value + ':' + parts.find(p => p.type === 'minute').value;
      const day = parts.find(p => p.type === 'weekday').value;
      const isWeekend = day === 'Sat' || day === 'Sun';
      isOpen = !isWeekend && time >= s.open && time <= s.close;
    }

    return `
      <div class="analysis-card">
        <h4>${s.flag} ${s.name}</h4>
        <div class="metric-row"><span class="k">Waktu Buka</span><span class="v">${s.open} – ${s.close}</span></div>
        <div class="metric-row"><span class="k">Timezone</span><span class="v" style="font-size:0.6rem;">${s.tz || 'UTC'}</span></div>
        <div class="metric-row"><span class="k">Status</span><span class="v ${isOpen ? 'good' : 'bad'}">${isOpen ? '🟢 OPEN' : '🔴 CLOSED'}</span></div>
      </div>
    `;
  }).join('');
}

