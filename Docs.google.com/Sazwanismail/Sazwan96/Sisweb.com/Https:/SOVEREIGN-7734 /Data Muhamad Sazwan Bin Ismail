## 3) JavaScript — letak sebelum `</script>`

```js
// ═══════════════════════════════════════════════════════════════════════════
// MODULE: IDENTITY CERTIFICATE (IMMUTABLE + SHA-256 VERIFIED)
// ═══════════════════════════════════════════════════════════════════════════

/*
 * DATA TERAS — DIBEKUKAN PENUH (deep frozen)
 * Tidak boleh diubah, dipadam, atau ditulis ganti dari UI/console.
 * Setiap nilai di-hash dengan SHA-256 dan dirantai sebagai anchor.
 */
const CERTIFICATE_IDENTITY = (() => {
  const data = {
    // Reference codes (LOCKED)
    reference_code: 'CMC-REF-2026-MSI-003',
    serial_number: 'MSI-2026-07734',
    verification_sig: 'SHA-256 VERIFIED@SAZWAN96',

    // Personal data (LOCKED)
    full_name: 'Muhamad Sazwan Bin Ismail',
    date_of_birth: '22.10.1996',
    handle: '@SAZWAN96',
    github: 'Sazwanismail',
    origin: 'Sungai Petani, Kedah, Malaysia',

    // Meta
    issuer: 'SGAE Data Lake v3',
    registered_at: '2026-01-01T00:00:00Z',
    certificate_version: 'v1.0',
    classification: 'PERSONAL · NON-TRANSFERABLE',
  };

  // Deep freeze — recursive
  const deepFreeze = (obj) => {
    Object.freeze(obj);
    Object.getOwnPropertyNames(obj).forEach(prop => {
      if (obj[prop] !== null &&
          (typeof obj[prop] === 'object' || typeof obj[prop] === 'function') &&
          !Object.isFrozen(obj[prop])) {
        deepFreeze(obj[prop]);
      }
    });
    return obj;
  };

  return deepFreeze(data);
})();

// Cache hash results (also frozen)
const CERT_HASHES = {
  identity: '',
  record: '',
  anchor: '',
  verified_at: '',
};

// ─────────────────────────────────────────────────────────────────────────
// Compute SHA-256 hash of a string
// ─────────────────────────────────────────────────────────────────────────
async function sha256Hex(input) {
  const enc = new TextEncoder();
  const buf = enc.encode(input);
  const hash = await crypto.subtle.digest('SHA-256', buf);
  return Array.from(new Uint8Array(hash))
    .map(b => b.toString(16).padStart(2, '0'))
    .join('');
}

// ─────────────────────────────────────────────────────────────────────────
// Compute & display certificate hashes
// ─────────────────────────────────────────────────────────────────────────
async function computeCertificateHashes() {
  const I = CERTIFICATE_IDENTITY;

  // 1) Identity hash — combination of core identity fields
  const identityString = [
    I.full_name,
    I.date_of_birth,
    I.reference_code,
    I.serial_number,
    I.handle,
    I.origin,
  ].join('|');
  CERT_HASHES.identity = await sha256Hex(identityString);

  // 2) Record hash — full JSON of all data
  const recordString = JSON.stringify(I, Object.keys(I).sort());
  CERT_HASHES.record = await sha256Hex(recordString);

  // 3) Chain anchor — identity + record + signature
  CERT_HASHES.anchor = await sha256Hex(
    CERT_HASHES.identity + ':' + CERT_HASHES.record + ':' + I.verification_sig
  );

  CERT_HASHES.verified_at = new Date().toISOString();
}

// ─────────────────────────────────────────────────────────────────────────
// Render certificate into DOM
// ─────────────────────────────────────────────────────────────────────────
async function renderCertificate() {
  const I = CERTIFICATE_IDENTITY;

  // Compute hashes first
  await computeCertificateHashes();

  // Initials
  const initials = I.full_name
    .split(' ')
    .filter(w => /^[A-Za-z]/.test(w))
    .map(w => w[0])
    .filter((v, i, a) => a.indexOf(v) === i)
    .slice(0, 3)
    .join('')
    .toUpperCase();
  document.getElementById('cert-initials').textContent = initials || 'MS';

  // Main fields
  document.getElementById('cert-name').textContent = I.full_name;
  document.getElementById('cert-f-name').textContent = I.full_name;
  document.getElementById('cert-f-dob').textContent = I.date_of_birth;
  document.getElementById('cert-f-ref1').textContent = I.reference_code;
  document.getElementById('cert-f-ref2').textContent = I.serial_number;
  document.getElementById('cert-f-handle').textContent = I.handle;
  document.getElementById('cert-f-origin').textContent = I.origin;
  document.getElementById('cert-sig').textContent = I.verification_sig;

  // Hashes display
  document.getElementById('cert-hash-id').textContent = CERT_HASHES.identity;
  document.getElementById('cert-hash-rec').textContent = CERT_HASHES.record;
  document.getElementById('cert-hash-anchor').textContent = CERT_HASHES.anchor;
  document.getElementById('cert-verified-at').textContent = new Date(CERT_HASHES.verified_at).toLocaleString('ms-MY');

  // Console log
  console.log('%c🔐 SGAE Certificate Verified', 'color:#10b981;font-weight:bold;font-size:14px;');
  console.log('%cReference: ' + I.reference_code, 'color:#60a5fa;');
  console.log('%cSerial: ' + I.serial_number, 'color:#fbbf24;');
  console.log('%cSHA-256 Anchor: ' + CERT_HASHES.anchor, 'color:#22d3ee;font-family:monospace;');
}

// ─────────────────────────────────────────────────────────────────────────
// Verify certificate (compare against frozen data)
// ─────────────────────────────────────────────────────────────────────────
async function verifyCertificate() {
  const I = CERTIFICATE_IDENTITY;

  // Recompute
  const identityString = [
    I.full_name, I.date_of_birth, I.reference_code,
    I.serial_number, I.handle, I.origin,
  ].join('|');
  const newIdentity = await sha256Hex(identityString);

  const recordString = JSON.stringify(I, Object.keys(I).sort());
  const newRecord = await sha256Hex(recordString);

  const newAnchor = await sha256Hex(
    newIdentity + ':' + newRecord + ':' + I.verification_sig
  );

  const match =
    newIdentity === CERT_HASHES.identity &&
    newRecord === CERT_HASHES.record &&
    newAnchor === CERT_HASHES.anchor;

  if (match) {
    showToast(
      '✅ Certificate VALID',
      `Rantaian SHA-256 utuh. Anchor: ${newAnchor.substring(0, 16)}…`,
      'success'
    );
    document.getElementById('cert-sig').style.background = 'rgba(16,185,129,0.12)';
    document.getElementById('cert-sig').style.color = 'var(--green)';
  } else {
    showToast(
      '❌ INTEGRITY BREACH',
      'Hash tidak sepadan! Data mungkin telah diubah.',
      'danger'
    );
    document.getElementById('cert-sig').style.background = 'rgba(239,68,68,0.15)';
    document.getElementById('cert-sig').style.color = 'var(--red)';
  }

  return { valid: match, newAnchor };
}

// ─────────────────────────────────────────────────────────────────────────
// Copy full certificate as JSON
// ─────────────────────────────────────────────────────────────────────────
async function copyFullCertificate() {
  const I = CERTIFICATE_IDENTITY;
  const payload = {
    certificate: {
      ...I,
      hashes: {
        identity_sha256: CERT_HASHES.identity,
        record_sha256: CERT_HASHES.record,
        chain_anchor_sha256: CERT_HASHES.anchor,
        verified_at: CERT_HASHES.verified_at,
      },
      integrity: 'SHA-256 · Immutable · Frozen',
    },
    generated_at: new Date().toISOString(),
    generator: 'SGAE Data Lake v3',
  };
  const txt = JSON.stringify(payload, null, 2);
  try {
    await navigator.clipboard.writeText(txt);
    showToast('Certificate Copied', 'JSON penuh disalin ke clipboard', 'success');
  } catch {
    showToast('Gagal', 'Clipboard tidak dibenarkan', 'warning');
  }
}

// ─────────────────────────────────────────────────────────────────────────
// Attempt to modify (BLOCKED — for demonstration)
// ─────────────────────────────────────────────────────────────────────────
function attemptModifyCertificate() {
  try {
    CERTIFICATE_IDENTITY.reference_code = 'HACKED-0000';
    showToast('🚨 Anomali', 'Perubahan berjaya?! Sila lapor segera.', 'danger');
  } catch (e) {
    showToast('🔒 Dikunci', 'Data immutable — perubahan disekat oleh Object.freeze()', 'success');
  }
  // Even in non-strict mode, frozen object won't change:
  console.log('Reference after modify attempt:', CERTIFICATE_IDENTITY.reference_code);
}
