export function toCSV(data) {
  const rows = [["id","category","name","publisher","desc","tag"]];
  data.categories.forEach(cat => {
    cat.templates.forEach(t => {
      rows.push([t.id, cat.name, t.name, t.publisher, t.desc, t.tag]);
