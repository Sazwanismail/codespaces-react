  doc.text('MUHAMAD SAZWAN BIN ISMAIL · MSI-2026-07734', 14, 28);
  doc.text('Date: ' + new Date().toLocaleString('ms-MY'), 14, 34);
  
  const rows = Object.keys(localStorage).filter(k => k.startsWith('sgae_')).map(k => [k, (localStorage.getItem(k) || '').substring(0, 80)]);
  if (rows.length > 0) {
    doc.autoTable({ startY: 45, head: [['Key', 'Value']], body: rows, headStyles: { fillColor: [0, 229, 255] } });
  }
