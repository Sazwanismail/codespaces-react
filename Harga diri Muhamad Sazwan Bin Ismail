let timerInterval = null, timerRemaining = 0;
function timerStart() {
  const mins = parseInt(document.getElementById('timerMinutes').value) || 5;
  timerRemaining = mins * 60;
  clearInterval(timerInterval);
  timerInterval = setInterval(() => {
    if (timerRemaining <= 0) { clearInterval(timerInterval); alert('⏰ Timer selesai!'); return; }
    timerRemaining--;
    const h = String(Math.floor(timerRemaining / 3600)).padStart(2, '0');
    const m = String(Math.floor((timerRemaining % 3600) / 60)).padStart(2, '0');
    const s = String(timerRemaining % 60).padStart(2, '0');
