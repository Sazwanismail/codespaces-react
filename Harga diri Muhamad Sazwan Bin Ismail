function openMail(id) {
  const m = INBOX.find(x => x.id === id);
  if (!m) return;
  m.unread = false;
  alert(`📧 Dari: ${m.from}\n\n${m.subject}\n\n${m.body}\n\n⏰ ${m.time}`);
  renderMessaging();
}

function sendMessage() {
  const to = document.getElementById('msgTo').value;
  const subject = document.getElementById('msgSubject').value;
  const body = document.getElementById('msgBody').value;
  
  if (!to || !subject) { alert('⚠️ Sila isi penerima dan subjek'); return; }
  
  const sent = { to, subject, body, date: new Date().toISOString(), from: 'MUHAMAD SAZWAN BIN ISMAIL' };
  localStorage.setItem('sgae_sent_' + Date.now(), JSON.stringify(sent));
  
  alert(`✅ Mesej dihantar!\n\nKepada: ${to}\nSubjek: ${subject}`);
  
  document.getElementById('msgTo').value = '';
  document.getElementById('msgSubject').value = '';
  document.getElementById('msgBody').value = '';
  renderMessaging();
}

function saveDraft() {
  const to = document.getElementById('msgTo').value;
  const subject = document.getElementById('msgSubject').value;
  const body = document.getElementById('msgBody').value;
  if (!subject && !body) { alert('⚠️ Tiada draf untuk disimpan'); return; }
  const draft = { to, subject, body, date: new Date().toISOString() };
  localStorage.setItem('sgae_draft_' + Date.now(), JSON.stringify(draft));
  alert('💾 Draf disimpan!');
  renderMessaging();
}

