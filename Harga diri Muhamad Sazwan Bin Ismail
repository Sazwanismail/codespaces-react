}

function restoreBackup() {
  const file = document.getElementById('restoreFile').files[0];
  if (!file) { alert('⚠️ Sila pilih fail backup'); return; }
  if (!confirm('⚠️ Restore akan menimpa data semasa. Teruskan?')) return;
  
  const reader = new FileReader();
  reader.onload = (e) => {
    try {
      const data = JSON.parse(e.target.result);
      Object.keys(data).forEach(k => localStorage.setItem(k, data[k]));
      alert('✅ Backup berjaya dipulihkan! ' + Object.keys(data).length + ' rekod dimuatkan.');
      location.reload();
    } catch (err) {
      alert('❌ Fail backup tidak sah: ' + err.message);
    }
  };
  reader.readAsText(file);
}

