function quickTranslate(key) {
  const srcLang = document.getElementById('srcLang').value === 'auto' ? 'ms' : document.getElementById('srcLang').value;
  const tgtLang = document.getElementById('tgtLang').value;
  const srcText = TRANSLATIONS[srcLang]?.[key] || TRANSLATIONS.ms[key];
  document.getElementById('srcText').value = srcText;
  translateText();
}

function translateText() {
  const srcText = document.getElementById('srcText').value.trim();
  const srcLang = document.getElementById('srcLang').value;
  const tgtLang = document.getElementById('tgtLang').value;
  
  if (!srcText) {
    document.getElementById('tgtText').innerHTML = '<span style="color:#ef4444">⚠️ Sila masukkan teks</span>';
    return;
  }
  
  document.getElementById('tgtText').innerHTML = '<span style="color:var(--muted)">⏳ Translating...</span>';
  
  // Try using free translation API with fallback to local
  translateViaAPI(srcText, srcLang, tgtLang);
}

async function translateViaAPI(text, src, tgt) {
  const srcLang = src === 'auto' ? 'auto' : src;
  try {
    // Use MyMemory Translation API (free, no key required)
    const url = `https://api.mymemory.translated.net/get?q=${encodeURIComponent(text)}&langpair=${srcLang}|${tgt}`;
    const controller = new AbortController();
    const timeout = setTimeout(() => controller.abort(), 8000);
    const res = await fetch(url, { signal: controller.signal });
    clearTimeout(timeout);
    const data = await res.json();
    
    if (data && data.responseData && data.responseData.translatedText) {
      const translated = data.responseData.translatedText;
      document.getElementById('tgtText').innerHTML = translated;
      saveRecentTranslation(text, translated, src, tgt);
    } else {
      throw new Error('API response invalid');
    }
  } catch (err) {
    // Fallback to local dictionary
    const localTranslation = localTranslate(text, src, tgt);
    document.getElementById('tgtText').innerHTML = `
      <div style="color:var(--gold)">${localTranslation}</div>
      <div style="color:var(--muted);font-size:11px;margin-top:8px">⚠️ Offline mode — guna kamus terbina dalam</div>
    `;
    saveRecentTranslation(text, localTranslation, src, tgt);
  }
}

function localTranslate(text, src, tgt) {
  // Try to translate word by word using dictionary
  const srcDict = TRANSLATIONS[src === 'auto' ? 'ms' : src] || TRANSLATIONS.ms;
  const tgtDict = TRANSLATIONS[tgt] || TRANSLATIONS.en;
  
  let result = text;
  Object.keys(srcDict).forEach(key => {
    const srcWord = srcDict[key];
    const tgtWord = tgtDict[key];
    if (srcWord && tgtWord) {
      const regex = new RegExp(srcWord, 'gi');
      result = result.replace(regex, tgtWord);
    }
  });
  
  if (result === text) {
    return `[${tgt.toUpperCase()}] ${text} (terjemahan kamus terhad)`;
  }
  return result;
}

function saveRecentTranslation(src, tgt, srcLang, tgtLang) {
  const recent = JSON.parse(localStorage.getItem('sgae_recent_trans') || '[]');
  recent.push({ src, tgt, srcLang, tgtLang, time: new Date().toLocaleString('ms-MY') });
  localStorage.setItem('sgae_recent_trans', JSON.stringify(recent.slice(-20)));
  renderTranslator();
}

