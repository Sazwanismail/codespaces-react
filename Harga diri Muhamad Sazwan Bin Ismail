  h += '<div class="month-cal">';
  dayNames.forEach(d => h += `<div class="day-name">${d}</div>`);
  
  for (let i = 0; i < firstDay; i++) h += '<div class="day empty"></div>';
  
  for (let d = 1; d <= daysInMonth; d++) {
    const isToday = d === now.getDate();
    const hasEvent = EVENTS && EVENTS.some(e => {
      const ed = new Date(e.date);
      return ed.getFullYear() === year && ed.getMonth() === month && ed.getDate() === d;
    });
    h += `<div class="day ${isToday ? 'today' : ''} ${hasEvent ? 'has-event' : ''}">${d}</div>`;
  }
  h += '</div>';
  
  document.getElementById('monthCalendar').innerHTML = h;
}

function getWeekNumber(date) {
  const d = new Date(Date.UTC(date.getFullYear(), date.getMonth(), date.getDate()));
  const dayNum = d.getUTCDay() || 7;
  d.setUTCDate(d.getUTCDate() + 4 - dayNum);
  const yearStart = new Date(Date.UTC(d.getUTCFullYear(), 0, 1));
  return Math.ceil((((d - yearStart) / 86400000) + 1) / 7);
}

function getDayOfYear(date) {
  const start = new Date(date.getFullYear(), 0, 0);
  const diff = date - start;
  return Math.floor(diff / 86400000);
}

