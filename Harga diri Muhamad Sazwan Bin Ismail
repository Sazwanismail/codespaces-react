  { id: 'EVT-014', date: '2030-12-31', title: 'Next Generation Succession', type: 'family', color: 'pink' }
];

let calendarView = 'list';

function renderCalendar() {
  const today = new Date('2026-09-23');
  const upcoming = EVENTS.filter(e => new Date(e.date) >= today).length;
  const past = EVENTS.filter(e => new Date(e.date) < today).length;
  const next = EVENTS.filter(e => new Date(e.date) >= today).sort((a,b) => new Date(a.date) - new Date(b.date))[0];
  
  document.getElementById('calendarKPI').innerHTML = `
    <div class="kpi"><div class="label">Total Events</div><div class="value cyan">${EVENTS.length}</div></div>
    <div class="kpi"><div class="label">Past</div><div class="value green">${past}</div></div>
    <div class="kpi"><div class="label">Upcoming</div><div class="value gold">${upcoming}</div></div>
    <div class="kpi"><div class="label">Next Event</div><div class="value purple" style="font-size:13px">${next ? next.date : '-'}</div><div class="sub">${next ? next.title.substring(0, 30) : '—'}</div></div>
  `;
  
  if (calendarView === 'list') {
    let h = '';
    EVENTS.forEach(e => {
      const isPast = new Date(e.date) < today;
      h += `<div class="info-box" style="border-left:4px solid var(--${e.color === 'gold' ? 'gold' : e.color === 'cyan' ? 'cyan' : e.color === 'pink' ? 'pink' : e.color === 'green' ? 'green' : 'purple'})">
        <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px">
          <div>
            <div class="mono ${e.color === 'gold' ? 'gold' : e.color}" style="font-size:12px">${e.date}</div>
            <div style="font-weight:700;color:#fff;font-size:13px;margin-top:4px">${e.title}</div>
          </div>
          <span style="background:rgba(52,168,83,0.15);color:#81c995;padding:3px 10px;border-radius:10px;font-size:10px;font-weight:600">${isPast ? '✅ DONE' : '⏳ UPCOMING'}</span>
        </div>
      </div>`;
    });
    document.getElementById('calendarContent').innerHTML = h;
  } else {
    // Month view - simplified
    let h = '<div style="display:grid;grid-template-columns:repeat(12,1fr);gap:6px;text-align:center;font-size:11px">';
    ['Jan','Feb','Mac','Apr','Mei','Jun','Jul','Ogo','Sep','Okt','Nov','Dis'].forEach((m, i) => {
      const monthEvents = EVENTS.filter(e => parseInt(e.date.split('-')[1]) === i+1);
      h += `<div style="background:var(--card2);padding:8px 4px;border-radius:6px;min-height:60px;border:1px solid var(--border)">
        <div style="color:var(--muted);font-size:10px">${m}</div>
        <div style="font-weight:700;color:var(--cyan);font-size:14px">${monthEvents.length}</div>
        <div style="font-size:9px;color:var(--muted)">events</div>
      </div>`;
    });
    h += '</div>';
    document.getElementById('calendarContent').innerHTML = h;
  }
}

function setView(v) { calendarView = v; renderCalendar(); }
function addEvent() {
  const title = prompt('📅 Tajuk acara:');
  if (!title) return;
  const date = prompt('📅 Tarikh (YYYY-MM-DD):', '2027-01-01');
  if (!date) return;
  EVENTS.push({ id: 'EVT-' + String(EVENTS.length + 1).padStart(3, '0'), date, title, type: 'custom', color: 'cyan' });
  renderCalendar();
  alert('✅ Acara ditambah!');
}
function exportCalendar() {
  let ics = 'BEGIN:VCALENDAR\nVERSION:2.0\nPRODID:-//SGAE 2.0//Sovereign Calendar//MS\n';
  EVENTS.forEach(e => {
    const d = e.date.replace(/-/g, '');
    ics += `BEGIN:VEVENT\nUID:${e.id}\nDTSTART:${d}T000000Z\nDTEND:${d}T235959Z\nSUMMARY:${e.title}\nEND:VEVENT\n`;
  });
  ics += 'END:VCALENDAR';
  downloadFile(ics, 'sgae_calendar.ics', 'text/calendar');
}

