const CONVERSION_HISTORY = [];

function renderConverter() {
  document.getElementById('converterKPI').innerHTML = `
    <div class="kpi"><div class="label">Currencies</div><div class="value cyan">${Object.keys(CURRENCY_RATES).length}</div></div>
