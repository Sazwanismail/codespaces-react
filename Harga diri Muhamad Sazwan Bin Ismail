  `;
  runSimulation();
}

function runSimulation() {
  const amount = parseFloat(document.getElementById('simAmount').value) || 10000;
  const years = parseInt(document.getElementById('simYears').value) || 5;
  const projection = parseFloat(document.getElementById('simProjection').value) / 100 || 0.45;
  
  let data = [];
  let value = amount;
  for (let i = 0; i <= years; i++) {
    data.push(Math.round(value));
    value *= (1 + projection);
  }
  
  const finalValue = data[data.length - 1];
  const profit = finalValue - amount;
  const roi = ((finalValue - amount) / amount * 100).toFixed(1);
  
  document.getElementById('simResult').innerHTML = `
    <div class="info-box" style="border-left:4px solid var(--green)">
      <div style="font-size:16px;font-weight:900;color:var(--gold);margin-bottom:8px">💰 RM ${finalValue.toLocaleString()}</div>
      <div style="display:flex;justify-content:space-between;margin-top:8px">
        <span>Pelaburan Awal:</span><span class="cyan mono">RM ${amount.toLocaleString()}</span>
      </div>
      <div style="display:flex;justify-content:space-between;margin-top:6px">
        <span>Keuntungan:</span><span class="green mono">+RM ${profit.toLocaleString()}</span>
      </div>
      <div style="display:flex;justify-content:space-between;margin-top:6px">
        <span>ROI:</span><span class="gold mono">${roi}%</span>
      </div>
      <div style="display:flex;justify-content:space-between;margin-top:6px">
        <span>Tempoh:</span><span class="purple mono">${years} tahun</span>
      </div>
      <div style="display:flex;justify-content:space-between;margin-top:6px">
        <span>Projek Saham:</span><span class="blue mono">${(projection*100).toFixed(0)}% / tahun</span>
      </div>
    </div>`;
  
  if (simChartInst) simChartInst.destroy();
  const ctx = document.getElementById('simChart').getContext('2d');
  simChartInst = new Chart(ctx, {
    type: 'line',
    data: {
      labels: Array.from({ length: years + 1 }, (_, i) => `Tahun ${i}`),
      datasets: [{
        label: 'Nilai Portfolio (RM)',
        data: data,
        borderColor: '#ffd700',
        backgroundColor: 'rgba(255,215,0,0.1)',
        fill: true,
        tension: 0.4
      }]
    },
    options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { labels: { color: '#e8eaed' } } }, scales: { x: { ticks: { color: '#94a3b8' } }, y: { ticks: { color: '#94a3b8' } } } }
  });
}

