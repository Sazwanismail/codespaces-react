  `;
  
  let h = '';
  INBOX.forEach(m => {
    h += `<div class="mail-item ${m.unread ? 'unread' : ''}" onclick="openMail('${m.id}')">
      <div style="display:flex;justify-content:space-between;align-items:flex-start">
