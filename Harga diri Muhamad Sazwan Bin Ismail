function renderMessaging() {
  const unreadCount = INBOX.filter(m => m.unread).length;
  document.getElementById('messagingKPI').innerHTML = `
    <div class="kpi"><div class="label">Total Mesej</div><div class="value cyan">${INBOX.length}</div></div>
    <div class="kpi"><div class="label">Belum Dibaca</div><div class="value gold">${unreadCount}</div></div>
    <div class="kpi"><div class="label">Drafts</div><div class="value purple">${Object.keys(localStorage).filter(k => k.startsWith('sgae_draft_')).length}</div></div>
