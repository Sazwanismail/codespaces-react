async function testAPI() {
  const method = document.getElementById('apiMethod').value;
  const url = document.getElementById('apiURL').value;
  const headersText = document.getElementById('apiHeaders').value;
  const respDiv = document.getElementById('apiResponse');
  const statusTag = document.getElementById('apiStatus');
  const timeTag = document.getElementById('apiTime');
  const sizeTag = document.getElementById('apiSize');
  
  respDiv.textContent = '⏳ Sending request...';
  statusTag.textContent = '⏳ Loading';
  statusTag.className = 'tag';
  
  const start = performance.now();
  try {
    const headers = headersText ? JSON.parse(headersText) : { 'Accept': 'application/json' };
    const controller = new AbortController();
    const timeoutId = setTimeout(() => controller.abort(), 8000);
    const res = await fetch(url, { method, headers, signal: controller.signal });
    clearTimeout(timeoutId);
    const elapsed = Math.round(performance.now() - start);
    const text = await res.text();
    
    let formatted = text;
    try { formatted = JSON.stringify(JSON.parse(text), null, 2); } catch (e) {}
    
    respDiv.textContent = formatted;
    statusTag.textContent = `✅ ${res.status} ${res.statusText || 'OK'}`;
    statusTag.className = 'tag';
    timeTag.textContent = `${elapsed} ms`;
    sizeTag.textContent = `${(text.length / 1024).toFixed(2)} KB`;
  } catch (err) {
    const elapsed = Math.round(performance.now() - start);
    respDiv.textContent = `❌ Error: ${err.message}\n\nURL: ${url}\nMethod: ${method}\n\n💡 Pastikan API berjalan di http://localhost:8000 atau cuba URL alternatif.`;
    statusTag.textContent = '❌ Failed';
    statusTag.className = 'tag';
    timeTag.textContent = `${elapsed} ms`;
    sizeTag.textContent = '0 B';
  }
}

