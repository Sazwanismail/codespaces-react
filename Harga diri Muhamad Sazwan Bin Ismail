function generatePassword() {
  const length = parseInt(document.getElementById('pwLength').value);
  const upper = document.getElementById('pwUpper').checked ? 'ABCDEFGHJKLMNPQRSTUVWXYZ' : '';
  const lower = document.getElementById('pwLower').checked ? 'abcdefghijkmnopqrstuvwxyz' : '';
  const num = document.getElementById('pwNum').checked ? '23456789' : '';
  const sym = document.getElementById('pwSym').checked ? '!@#$%^&*-_=+?' : '';
  const chars = upper + lower + num + sym;
  
  if (!chars) { alert('⚠️ Pilih sekurang-kurangnya satu jenis aksara'); return; }
  
  let pw = '';
  for (let i = 0; i < length; i++) pw += chars[Math.floor(Math.random() * chars.length)];
  
  document.getElementById('pwGenerated').textContent = pw;
  document.getElementById('pwGenerated').dataset.pw = pw;
  
  const strength = calculateStrength(pw);
  document.getElementById('pwGenerated').style.borderColor = strength.color;
}

function calculateStrength(pw) {
  let score = 0;
  if (pw.length >= 12) score++;
  if (pw.length >= 20) score++;
  if (/[A-Z]/.test(pw)) score++;
  if (/[a-z]/.test(pw)) score++;
  if (/[0-9]/.test(pw)) score++;
  if (/[^A-Za-z0-9]/.test(pw)) score++;
  if (score >= 5) return { label: 'STRONG', color: '#34a853' };
  if (score >= 3) return { label: 'MEDIUM', color: '#ffd700' };
  return { label: 'WEAK', color: '#ef4444' };
}

function copyPassword() {
  const pw = document.getElementById('pwGenerated').dataset.pw;
  if (!pw) { alert('⚠️ Generate password dahulu'); return; }
  navigator.clipboard.writeText(pw).then(() => alert('📋 Password disalin!'));
}

function savePassword() {
  const pw = document.getElementById('pwGenerated').dataset.pw;
  if (!pw) { alert('⚠️ Generate password dahulu'); return; }
  const site = prompt('🏷️ Nama laman/aplikasi:', 'example.com');
  if (!site) return;
  const user = prompt('👤 Username (optional):', 'user@example.com') || '-';
  
  const vault = JSON.parse(localStorage.getItem('sgae_pwvault') || '[]');
  vault.push({ site, user, pw: btoa(pw), date: new Date().toISOString() });
  localStorage.setItem('sgae_pwvault', JSON.stringify(vault));
  alert('💾 Password disimpan dalam vault!');
  renderPWVault();
}

