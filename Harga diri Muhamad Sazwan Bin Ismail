}

function backupEncrypted() {
  const pw = prompt('🔐 Masukkan kata laluan untuk enkripsi backup:');
  if (!pw) return;
  const data = {};
  Object.keys(localStorage).filter(k => k.startsWith('sgae_')).forEach(k => {
    data[k] = localStorage.getItem(k);
  });
  const encrypted = btoa(pw + '::' + JSON.stringify(data));
  const blob = new Blob([encrypted], { type: 'application/octet-stream' });
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = 'sgae_encrypted_backup_' + Date.now() + '.sgvault';
  a.click();
  alert('🔐 Encrypted backup dimuat turun. Simpan kata laluan anda!');
}

