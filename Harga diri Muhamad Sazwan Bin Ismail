    <div class="kpi"><div class="label">Conversions</div><div class="value purple">${CONVERSION_HISTORY.length}</div></div>
  `;
  
  // Quick amounts
  const amounts = [100, 1000, 10000, 100000, 1000000];
  let qh = '';
  amounts.forEach(a => {
    qh += `<span class="quick-amount" onclick="setConvAmount(${a})">${a.toLocaleString()} MYR</span>`;
  });
  document.getElementById('convQuickAmounts').innerHTML = qh;
  
  // History
  if (CONVERSION_HISTORY.length === 0) {
    document.getElementById('convHistory').innerHTML = '<div style="text-align:center;padding:20px;color:var(--muted)">Tiada sejarah</div>';
  } else {
    let hh = '';
    CONVERSION_HISTORY.slice(-5).reverse().forEach(h => {
      hh += `<div class="audio-history-item">
        <div class="src">${h.from} → ${h.to}</div>
        <div class="tgt">${h.result}</div>
        <div class="meta"><span>${h.time}</span></div>
      </div>`;
    });
    document.getElementById('convHistory').innerHTML = hh;
  }
  
  convertCurrency();
}

function convertCurrency() {
  const amount = parseFloat(document.getElementById('convAmount').value) || 0;
  const from = document.getElementById('convFrom').value;
  const to = document.getElementById('convTo').value;
  
  if (!CURRENCY_RATES[from] || !CURRENCY_RATES[to]) return;
  
  const rate = CURRENCY_RATES[to] / CURRENCY_RATES[from];
  const result = amount * rate;
  const decimals = result < 0.001 ? 8 : result < 1 ? 4 : result < 1000 ? 2 : 0;
  
  document.getElementById('convResult').textContent = `${result.toLocaleString(undefined, { minimumFractionDigits: decimals, maximumFractionDigits: decimals })} ${to}`;
  document.getElementById('convRate').textContent = `1 ${from} = ${rate.toFixed(decimals)} ${to}`;
  
  if (CONVERSION_HISTORY.length === 0 || CONVERSION_HISTORY[CONVERSION_HISTORY.length - 1].amount !== amount) {
    CONVERSION_HISTORY.push({ amount, from, to, result: `${amount} ${from} = ${result.toFixed(decimals)} ${to}`, time: new Date().toLocaleString('ms-MY') });
    if (CONVERSION_HISTORY.length > 20) CONVERSION_HISTORY.shift();
  }
}

function setConvAmount(a) {
  document.getElementById('convAmount').value = a;
  convertCurrency();
}

function swapConverter() {
  const from = document.getElementById('convFrom').value;
  const to = document.getElementById('convTo').value;
  document.getElementById('convFrom').value = to;
  document.getElementById('convTo').value = from;
  convertCurrency();
}

function setConverterFromTo(from, to) {
  document.querySelectorAll('.tab').forEach(t => { if (t.dataset.tab === 'converter') t.click(); });
  setTimeout(() => {
    document.getElementById('convFrom').value = from;
    document.getElementById('convTo').value = to;
    convertCurrency();
  }, 300);
}

