function renderBackup() {
  const history = JSON.parse(localStorage.getItem('sgae_backup_history') || '[]');
  const keys = Object.keys(localStorage).filter(k => k.startsWith('sgae_'));
  let totalSize = 0;
  keys.forEach(k => totalSize += (localStorage.getItem(k) || '').length);
  
  document.getElementById('backupKPI').innerHTML = `
    <div class="kpi"><div class="label">Total Records</div><div class="value cyan">${keys.length}</div></div>
    <div class="kpi"><div class="label">Storage Size</div><div class="value gold">${(totalSize / 1024).toFixed(2)} KB</div></div>
    <div class="kpi"><div class="label">Backups</div><div class="value green">${history.length}</div></div>
    <div class="kpi"><div class="label">Last Backup</div><div class="value purple" style="font-size:13px">${history.length ? new Date(history[history.length-1].date).toLocaleString('ms-MY') : 'Never'}</div></div>
  `;
  
  let h = '';
  history.slice(-10).reverse().forEach(b => {
    h += `<div class="backup-history-item">
      <div>
        <div class="file">📦 ${b.file}</div>
        <div style="font-size:11px;color:var(--muted)">${new Date(b.date).toLocaleString('ms-MY')}</div>
      </div>
      <div class="size">${b.size}</div>
    </div>`;
  });
  if (h === '') h = '<div style="text-align:center;padding:20px;color:var(--muted)">Tiada backup lagi</div>';
  document.getElementById('backupHistory').innerHTML = h;
}

function backupAll() {
  const data = {};
  Object.keys(localStorage).filter(k => k.startsWith('sgae_')).forEach(k => {
    data[k] = localStorage.getItem(k);
  });
  const json = JSON.stringify(data, null, 2);
  const blob = new Blob([json], { type: 'application/json' });
  const file = 'sgae_backup_' + new Date().toISOString().slice(0, 19).replace(/[:T]/g, '-') + '.json';
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = file;
  a.click();
  
  const history = JSON.parse(localStorage.getItem('sgae_backup_history') || '[]');
  history.push({ file, date: new Date().toISOString(), size: (json.length / 1024).toFixed(2) + ' KB' });
  localStorage.setItem('sgae_backup_history', JSON.stringify(history));
  renderBackup();
}

function backupCSV() {
  let csv = 'Key,Value\n';
  Object.keys(localStorage).filter(k => k.startsWith('sgae_')).forEach(k => {
    csv += `"${k}","${(localStorage.getItem(k) || '').replace(/"/g, '""').substring(0, 200)}"\n`;
  });
  const blob = new Blob([csv], { type: 'text/csv' });
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = 'sgae_backup_' + Date.now() + '.csv';
  a.click();
}

function backupExcel() {
  const data = [['Key', 'Value']];
  Object.keys(localStorage).filter(k => k.startsWith('sgae_')).forEach(k => {
    data.push([k, (localStorage.getItem(k) || '').substring(0, 500)]);
  });
  const wb = XLSX.utils.book_new();
  XLSX.utils.book_append_sheet(wb, XLSX.utils.aoa_to_sheet(data), 'Backup');
  XLSX.writeFile(wb, 'sgae_backup_' + Date.now() + '.xlsx');
}

function backupPDF() {
