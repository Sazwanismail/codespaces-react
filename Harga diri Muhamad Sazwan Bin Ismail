function updateClock() {
  const now = new Date();
  const h = String(now.getHours()).padStart(2, '0');
  const m = String(now.getMinutes()).padStart(2, '0');
  const s = String(now.getSeconds()).padStart(2, '0');
  const bigClock = document.getElementById('bigClock');
  if (bigClock) bigClock.textContent = `${h}:${m}:${s}`;
  
  const days = ['Ahad', 'Isnin', 'Selasa', 'Rabu', 'Khamis', 'Jumaat', 'Sabtu'];
  const months = ['Januari', 'Februari', 'Mac', 'April', 'Mei', 'Jun', 'Julai', 'Ogos', 'September', 'Oktober', 'November', 'Disember'];
  const bigDate = document.getElementById('bigDate');
  if (bigDate) bigDate.textContent = `${days[now.getDay()]}, ${now.getDate()} ${months[now.getMonth()]} ${now.getFullYear()}`;
  
  const tz = document.getElementById('bigTimezone');
  if (tz) {
    const offset = -now.getTimezoneOffset() / 60;
    tz.textContent = `Asia/Kuala_Lumpur · UTC+${offset >= 0 ? '+' : ''}${offset}`;
  }
}

function renderDatetime() {
  updateClock();
  
  document.getElementById('datetimeKPI').innerHTML = `
    <div class="kpi"><div class="label">Timezone</div><div class="value cyan">MYT</div><div class="sub">UTC+8</div></div>
    <div class="kpi"><div class="label">Unix Timestamp</div><div class="value gold mono" style="font-size:14px" id="unixTime">${Math.floor(Date.now()/1000)}</div></div>
    <div class="kpi"><div class="label">Week</div><div class="value purple" id="weekNumber">W${getWeekNumber(new Date())}</div></div>
    <div class="kpi"><div class="label">Day of Year</div><div class="value green" id="dayOfYear">${getDayOfYear(new Date())}</div></div>
  `;
  
  // Timezones
  const zones = [
    { city: 'Kuala Lumpur', flag: '🇲🇾', offset: 8, tz: 'Asia/Kuala_Lumpur' },
    { city: 'Singapore', flag: '🇸🇬', offset: 8, tz: 'Asia/Singapore' },
    { city: 'Jakarta', flag: '🇮🇩', offset: 7, tz: 'Asia/Jakarta' },
    { city: 'Tokyo', flag: '🇯🇵', offset: 9, tz: 'Asia/Tokyo' },
    { city: 'Dubai', flag: '🇦🇪', offset: 4, tz: 'Asia/Dubai' },
    { city: 'London', flag: '🇬🇧', offset: 0, tz: 'Europe/London' },
    { city: 'Zurich', flag: '🇨🇭', offset: 1, tz: 'Europe/Zurich' },
    { city: 'New York', flag: '🇺🇸', offset: -5, tz: 'America/New_York' },
    { city: 'Los Angeles', flag: '🇺🇸', offset: -8, tz: 'America/Los_Angeles' },
    { city: 'Sydney', flag: '🇦🇺', offset: 11, tz: 'Australia/Sydney' },
    { city: 'Tallinn', flag: '🇪🇪', offset: 2, tz: 'Europe/Tallinn' },
    { city: 'Riyadh', flag: '🇸🇦', offset: 3, tz: 'Asia/Riyadh' }
  ];
  
  function updateZones() {
    const now = new Date();
    let h = '';
    zones.forEach(z => {
      const utc = now.getTime() + (now.getTimezoneOffset() * 60000);
      const localTime = new Date(utc + (z.offset * 3600000));
      const t = `${String(localTime.getHours()).padStart(2,'0')}:${String(localTime.getMinutes()).padStart(2,'0')}:${String(localTime.getSeconds()).padStart(2,'0')}`;
      const d = `${String(localTime.getDate()).padStart(2,'0')}/${String(localTime.getMonth()+1).padStart(2,'0')}/${localTime.getFullYear()}`;
      h += `<div class="timezone-card">
        <div class="flag">${z.flag}</div>
        <div class="city">${z.city}</div>
        <div class="time">${t}</div>
        <div class="date">${d}</div>
        <div class="tz">UTC${z.offset >= 0 ? '+' : ''}${z.offset}</div>
      </div>`;
    });
    const el = document.getElementById('timezoneGrid');
    if (el) el.innerHTML = h;
  }
  updateZones();
  setInterval(updateZones, 1000);
  
  // Month Calendar
  renderMonthCalendar();
}

function renderMonthCalendar() {
  const now = new Date();
  const year = now.getFullYear();
  const month = now.getMonth();
  const firstDay = new Date(year, month, 1).getDay();
  const daysInMonth = new Date(year, month + 1, 0).getDate();
  const monthNames = ['Januari', 'Februari', 'Mac', 'April', 'Mei', 'Jun', 'Julai', 'Ogos', 'September', 'Oktober', 'November', 'Disember'];
  const dayNames = ['Ahd', 'Isn', 'Sel', 'Rab', 'Kha', 'Jum', 'Sab'];
  
  let h = `<h4 style="margin-bottom:12px;color:var(--cyan)">${monthNames[month]} ${year}</h4>`;
  h += '<div class="month-cal">';
  dayNames.forEach(d => h += `<div class="day-name">${d}</div>`);
  
  for (let i = 0; i < firstDay; i++) h += '<div class="day empty"></div>';
  
  for (let d = 1; d <= daysInMonth; d++) {
    const isToday = d === now.getDate();
    const hasEvent = EVENTS && EVENTS.some(e => {
      const ed = new Date(e.date);
      return ed.getFullYear() === year && ed.getMonth() === month && ed.getDate() === d;
    });
    h += `<div class="day ${isToday ? 'today' : ''} ${hasEvent ? 'has-event' : ''}">${d}</div>`;
  }
  h += '</div>';
  
  document.getElementById('monthCalendar').innerHTML = h;
}

function getWeekNumber(date) {
  const d = new Date(Date.UTC(date.getFullYear(), date.getMonth(), date.getDate()));
  const dayNum = d.getUTCDay() || 7;
  d.setUTCDate(d.getUTCDate() + 4 - dayNum);
  const yearStart = new Date(Date.UTC(d.getUTCFullYear(), 0, 1));
  return Math.ceil((((d - yearStart) / 86400000) + 1) / 7);
}

function getDayOfYear(date) {
  const start = new Date(date.getFullYear(), 0, 0);
  const diff = date - start;
  return Math.floor(diff / 86400000);
}

