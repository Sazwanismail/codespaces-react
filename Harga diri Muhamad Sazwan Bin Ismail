let goalsChartInst;
function renderGoals() {
  const avgProgress = GOALS.reduce((a, g) => a + (g.current/g.target)*100, 0) / GOALS.length;
  const completed = GOALS.filter(g => g.current >= g.target).length;
  
  document.getElementById('goalsKPI').innerHTML = `
    <div class="kpi"><div class="label">Total KPI</div><div class="value cyan">${GOALS.length}</div></div>
    <div class="kpi"><div class="label">Avg Progress</div><div class="value gold">${avgProgress.toFixed(1)}%</div></div>
    <div class="kpi"><div class="label">Completed</div><div class="value green">${completed}</div></div>
    <div class="kpi"><div class="label">In Progress</div><div class="value orange">${GOALS.length - completed}</div></div>
  `;
  
  let h = '';
  GOALS.forEach(g => {
    const pct = Math.min(100, (g.current/g.target)*100);
    h += `<div class="kpi-progress">
      <div class="header">
        <div class="name">${g.name}</div>
        <div class="value">${g.current} / ${g.target} ${g.unit} · ${pct.toFixed(1)}%</div>
      </div>
      <div class="track"><div class="fill" style="width:${pct}%"></div></div>
      <div class="target">🎯 Target: ${g.target} ${g.unit} ${pct >= 100 ? '· ✅ SELESAI' : ''}</div>
    </div>`;
  });
  document.getElementById('goalsContent').innerHTML = h;
  
  if (goalsChartInst) goalsChartInst.destroy();
  const ctx = document.getElementById('goalsChart').getContext('2d');
  goalsChartInst = new Chart(ctx, {
    type: 'bar',
    data: {
      labels: GOALS.map(g => g.name.split(' ').slice(0, 2).join(' ')),
      datasets: [
        { label: 'Current', data: GOALS.map(g => g.current), backgroundColor: '#00e5ff' },
        { label: 'Target', data: GOALS.map(g => g.target), backgroundColor: 'rgba(255,215,0,0.3)' }
      ]
    },
    options: { responsive: true, maintainAspectRatio: false, indexAxis: 'y', plugins: { legend: { labels: { color: '#e8eaed' } } }, scales: { x: { ticks: { color: '#94a3b8' } }, y: { ticks: { color: '#94a3b8', font: { size: 10 } } } } }
  });
}

