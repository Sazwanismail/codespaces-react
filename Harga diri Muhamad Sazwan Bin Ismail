function generateDesign() {
  const canvas = document.getElementById('designCanvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const W = canvas.width, H = canvas.height;
  ctx.clearRect(0, 0, W, H);
  
  const mainText = document.getElementById('designMainText').value || 'SGAE';
  const subText = document.getElementById('designSubText').value || '';
  const color1 = document.getElementById('designColor1').value;
  const color2 = document.getElementById('designColor2').value;
  const shape = document.getElementById('designShape').value;
  const icon = document.getElementById('designIcon').value;
  
  // Gradient
  const grad = ctx.createLinearGradient(0, 0, W, H);
  grad.addColorStop(0, color1);
  grad.addColorStop(1, color2);
  
  // Draw shape
  ctx.save();
  ctx.translate(W/2, H/2);
  ctx.fillStyle = grad;
  ctx.strokeStyle = color1;
  ctx.lineWidth = 6;
  
  if (shape === 'shield') {
    ctx.beginPath();
    ctx.moveTo(0, -120);
    ctx.lineTo(100, -60);
    ctx.lineTo(100, 40);
    ctx.quadraticCurveTo(0, 130, -100, 40);
    ctx.lineTo(-100, -60);
    ctx.closePath();
    ctx.fill();
    ctx.stroke();
  } else if (shape === 'circle') {
    ctx.beginPath();
    ctx.arc(0, 0, 120, 0, Math.PI * 2);
    ctx.fill();
    ctx.stroke();
  } else if (shape === 'hexagon') {
    ctx.beginPath();
    for (let i = 0; i < 6; i++) {
      const angle = (Math.PI / 3) * i - Math.PI / 2;
      const x = 120 * Math.cos(angle);
      const y = 120 * Math.sin(angle);
      if (i === 0) ctx.moveTo(x, y);
      else ctx.lineTo(x, y);
    }
    ctx.closePath();
    ctx.fill();
    ctx.stroke();
  } else if (shape === 'diamond') {
    ctx.beginPath();
    ctx.moveTo(0, -130);
    ctx.lineTo(100, 0);
    ctx.lineTo(0, 130);
    ctx.lineTo(-100, 0);
    ctx.closePath();
    ctx.fill();
    ctx.stroke();
  } else if (shape === 'star') {
    ctx.beginPath();
    for (let i = 0; i < 10; i++) {
      const angle = (Math.PI / 5) * i - Math.PI / 2;
      const r = i % 2 === 0 ? 130 : 60;
      const x = r * Math.cos(angle);
      const y = r * Math.sin(angle);
      if (i === 0) ctx.moveTo(x, y);
      else ctx.lineTo(x, y);
    }
    ctx.closePath();
    ctx.fill();
    ctx.stroke();
  }
  ctx.restore();
  
  // Draw icon
  ctx.font = '64px serif';
  ctx.textAlign = 'center';
  ctx.textBaseline = 'middle';
  ctx.fillText(icon, W/2, H/2 - 30);
  
  // Draw main text
  ctx.font = 'bold 48px Roboto, sans-serif';
  ctx.fillStyle = '#0a0f17';
  ctx.textAlign = 'center';
  ctx.textBaseline = 'middle';
  ctx.fillText(mainText, W/2, H/2 + 40);
  
  // Draw sub text
  if (subText) {
    ctx.font = 'bold 18px Roboto, sans-serif';
    ctx.fillStyle = '#0a0f17';
    ctx.fillText(subText, W/2, H/2 + 80);
  }
  
  // Border
  ctx.strokeStyle = '#fff';
  ctx.lineWidth = 3;
  ctx.strokeRect(10, 10, W - 20, H - 20);
}

