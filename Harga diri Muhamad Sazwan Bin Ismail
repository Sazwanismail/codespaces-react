    c.style.display = match ? '' : 'none';
  });
}

// ============================================================
//  5. TEXT-TO-SPEECH STUDIO
// ============================================================
function renderTTS() {
  document.getElementById('ttsKPI').innerHTML = `
    <div class="kpi"><div class="label">Status</div><div class="value green">🎙️ Ready</div></div>
    <div class="kpi"><div class="label">Engine</div><div class="value cyan">Web Speech API</div></div>
    <div class="kpi"><div class="label">Bahasa</div><div class="value gold">${LANGUAGES.length}</div></div>
    <div class="kpi"><div class="label">Voices</div><div class="value purple" id="voiceCount">-</div></div>
  `;
  
  // Populate voices
  if ('speechSynthesis' in window) {
    const populateVoices = () => {
      const voices = window.speechSynthesis.getVoices();
      const sel = document.getElementById('ttsVoice');
      if (sel) {
        sel.innerHTML = voices.map(v => `<option value="${v.name}">${v.name} (${v.lang})</option>`).join('');
      }
      document.getElementById('voiceCount').textContent = voices.length;
    };
    populateVoices();
    window.speechSynthesis.onvoiceschanged = populateVoices;
  }
  
  // Preset voices
  const presets = [
    { name: '🇲🇾 Bahasa Melayu', lang: 'ms-MY', rate: 1, pitch: 1 },
    { name: '🇬🇧 English (UK)', lang: 'en-GB', rate: 1, pitch: 1 },
    { name: '🇺🇸 English (US)', lang: 'en-US', rate: 1, pitch: 1 },
    { name: '🇨🇳 Chinese (Mandarin)', lang: 'zh-CN', rate: 0.9, pitch: 1 },
    { name: '🇯🇵 Japanese', lang: 'ja-JP', rate: 1, pitch: 1 },
    { name: '🇰🇷 Korean', lang: 'ko-KR', rate: 1, pitch: 1 },
    { name: '🇸🇦 Arabic', lang: 'ar-SA', rate: 0.9, pitch: 1 },
    { name: '🇮🇳 Hindi', lang: 'hi-IN', rate: 1, pitch: 1 },
    { name: '🇫🇷 French', lang: 'fr-FR', rate: 1, pitch: 1 },
    { name: '🇩🇪 German', lang: 'de-DE', rate: 1, pitch: 1 },
    { name: '🇪🇸 Spanish', lang: 'es-ES', rate: 1, pitch: 1 },
    { name: '🇷🇺 Russian', lang: 'ru-RU', rate: 1, pitch: 1 }
  ];
  
  let h = '';
  presets.forEach(p => {
    h += `<span class="phrase-btn" onclick="ttsPreset('${p.lang}', ${p.rate}, ${p.pitch})">${p.name}</span>`;
  });
  document.getElementById('ttsPresets').innerHTML = h;
}

function ttsPreset(lang, rate, pitch) {
  document.getElementById('ttsRate').value = rate;
  document.getElementById('ttsPitch').value = pitch;
  document.getElementById('ttsRateLabel').textContent = rate;
  document.getElementById('ttsPitchLabel').textContent = pitch;
  const text = document.getElementById('ttsText').value;
  speak(text, lang, rate, pitch);
}

function ttsSpeak() {
  const text = document.getElementById('ttsText').value;
  const rate = parseFloat(document.getElementById('ttsRate').value);
  const pitch = parseFloat(document.getElementById('ttsPitch').value);
  const voiceName = document.getElementById('ttsVoice').value;
  
  if (!('speechSynthesis' in window)) { alert('❌ TTS tidak disokong'); return; }
  
  window.speechSynthesis.cancel();
  const utt = new SpeechSynthesisUtterance(text);
  utt.rate = rate;
  utt.pitch = pitch;
  
  const voices = window.speechSynthesis.getVoices();
  const voice = voices.find(v => v.name === voiceName);
  if (voice) { utt.voice = voice; utt.lang = voice.lang; }
  
  window.speechSynthesis.speak(utt);
}

function ttsPause() {
  if (window.speechSynthesis.speaking && !window.speechSynthesis.paused) {
    window.speechSynthesis.pause();
  } else if (window.speechSynthesis.paused) {
    window.speechSynthesis.resume();
  }
}

function ttsStop() {
  window.speechSynthesis.cancel();
}

function ttsDownload() {
  alert('📥 Untuk download audio TTS, guna perisian rakaman atau MediaRecorder API.');
}

