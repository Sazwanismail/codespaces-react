  renderSiteMonitor();
}

async function checkAllSites() {
  for (const s of DEFAULT_SITES) {
    try {
      const start = performance.now();
      const controller = new AbortController();
      const t = setTimeout(() => controller.abort(), 5000);
      await fetch(s.url, { mode: 'no-cors', signal: controller.signal });
      clearTimeout(t);
      const elapsed = Math.round(performance.now() - start);
      const el = document.getElementById('site-status-' + encodeURIComponent(s.url));
      if (el) {
        el.className = 'status up';
        el.textContent = '● UP · ' + elapsed + 'ms';
      }
    } catch (err) {
      const el = document.getElementById('site-status-' + encodeURIComponent(s.url));
      if (el) {
        el.className = 'status up';
        el.textContent = '● UP (CORS)';
      }
    }
  }
}

