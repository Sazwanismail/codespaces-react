function startAudioRecording() {
  if (!('webkitSpeechRecognition' in window) && !('SpeechRecognition' in window)) {
    alert('❌ Pelayar tidak menyokong Speech Recognition.\n\nGuna Chrome atau Edge untuk fungsi audio.');
    return;
  }
  
  if (isRecording) {
    stopAudioRecording();
    return;
  }
  
  const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
  recognition = new SpeechRecognition();
  recognition.lang = currentAudioSrcLang;
  recognition.continuous = false;
  recognition.interimResults = true;
  
  recognition.onstart = () => {
    isRecording = true;
    document.getElementById('micBtn').classList.add('recording');
    document.getElementById('micStatus').textContent = '🔴 Sedang merakam... Bercakap sekarang';
    document.getElementById('audioTimer').style.display = 'block';
    audioSeconds = 0;
    audioTimerInterval = setInterval(() => {
      audioSeconds++;
      const m = String(Math.floor(audioSeconds / 60)).padStart(2, '0');
      const s = String(audioSeconds % 60).padStart(2, '0');
      document.getElementById('audioTimer').textContent = `${m}:${s}`;
    }, 1000);
  };
  
  recognition.onresult = (event) => {
    let transcript = '';
    for (let i = event.resultIndex; i < event.results.length; i++) {
      transcript += event.results[i][0].transcript;
    }
    document.getElementById('audioSrcText').textContent = transcript;
    document.getElementById('audioSrcLang').textContent = currentAudioSrcLang;
    document.getElementById('audioDuration').textContent = audioSeconds + 's';
  };
  
  recognition.onerror = (event) => {
    console.error('Recognition error:', event.error);
    document.getElementById('micStatus').textContent = '❌ Ralat: ' + event.error;
    stopAudioRecording();
  };
  
  recognition.onend = () => {
    document.getElementById('micStatus').textContent = '✅ Selesai merakam. Menterjemah...';
    stopAudioRecording();
    const srcText = document.getElementById('audioSrcText').textContent;
    if (srcText && srcText !== 'Menunggu input suara...') {
      translateAudio(srcText);
    }
  };
  
  recognition.start();
}

function stopAudioRecording() {
  isRecording = false;
  clearInterval(audioTimerInterval);
  document.getElementById('micBtn').classList.remove('recording');
  document.getElementById('audioTimer').style.display = 'none';
  if (recognition) {
    try { recognition.stop(); } catch(e) {}
  }
}

async function translateAudio(text) {
  const tgtLang = document.getElementById('tgtLang').value || 'en';
  const srcLang = currentAudioSrcLang.split('-')[0];
  
  document.getElementById('audioTgtText').innerHTML = '<span style="color:var(--muted)">⏳ Translating audio...</span>';
  
  try {
    const url = `https://api.mymemory.translated.net/get?q=${encodeURIComponent(text)}&langpair=${srcLang}|${tgtLang}`;
    const res = await fetch(url);
    const data = await res.json();
    if (data && data.responseData && data.responseData.translatedText) {
      const translated = data.responseData.translatedText;
      document.getElementById('audioTgtText').innerHTML = translated;
      
      // Auto-play translation
      const tgtVoice = getVoiceCode(tgtLang);
      setTimeout(() => speak(translated, tgtVoice), 500);
      
      audioHistory.push({ src: text, tgt: translated, srcLang, tgtLang, duration: audioSeconds, time: new Date().toLocaleString('ms-MY') });
      renderAudioTrans();
    } else throw new Error('Invalid response');
  } catch (err) {
    const fallback = localTranslate(text, srcLang, tgtLang);
    document.getElementById('audioTgtText').innerHTML = fallback;
    audioHistory.push({ src: text, tgt: fallback, srcLang, tgtLang, duration: audioSeconds, time: new Date().toLocaleString('ms-MY') });
    renderAudioTrans();
  }
}

function playAudioTranslation() {
  const text = document.getElementById('audioTgtText').textContent;
  const lang = getVoiceCode(document.getElementById('tgtLang').value || 'en');
  speak(text, lang);
}

