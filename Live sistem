## 5. FRONTEND LOGIC — `client/app.js`

```javascript
const socket = io();

let templates = [];
let filteredTemplates = [];

// ===== WEBSOCKET LIVE UPDATE =====
socket.on('connect', () => {
  document.getElementById('status-dot').className = 'dot online';
  document.getElementById('status-text').textContent = 'Aktif';
  document.getElementById('live-status').textContent = '🟢 Online';
  addLog('Disambung ke server');
});

socket.on('disconnect', () => {
  document.getElementById('status-dot').className = 'dot offline';
  document.getElementById('status-text').textContent = 'Terputus';
  document.getElementById('live-status').textContent = '🔴 Offline';
  addLog('Terputus dari server');
});

socket.on('template:added', (t) => {
  templates.push(t);
  renderTemplates();
  addLog(`➕ Templat ditambah: ${t.id} - ${t.name}`);
  updateStats();
});

socket.on('template:updated', (t) => {
  const idx = templates.findIndex(x => x.id === t.id);
  if (idx !== -1) templates[idx] = t;
  renderTemplates();
  addLog(`✏️ Templat dikemas kini: ${t.id} - ${t.name}`);
});

socket.on('template:deleted', ({ id }) => {
  templates = templates.filter(x => x.id !== id);
  renderTemplates();
  addLog(`🗑️ Templat dipadam: ${id}`);
  updateStats();
});

// ===== LOAD DATA =====
async function loadTemplates() {
  const res = await fetch('/api/templates');
  const json = await res.json();
  templates = json.data;
  renderTemplates();
  populateCategories();
  updateStats();
}

async function updateStats() {
  const res = await fetch('/api/stats');
  const json = await res.json();
  document.getElementById('total-templates').textContent = json.total;
  document.getElementById('total-categories').textContent = json.categories.length;
}

// ===== RENDER =====
function renderTemplates() {
  const container = document.getElementById('templates');
  const search = document.getElementById('search-input').value.toLowerCase();
  const cat = document.getElementById('category-filter').value;

  filteredTemplates = templates.filter(t => {
    const matchSearch = !search || 
      t.name.toLowerCase().includes(search) || 
      t.id.toLowerCase().includes(search) ||
      t.publisher.toLowerCase().includes(search);
    const matchCat = !cat || t.category === cat;
    return matchSearch && matchCat;
  });

  container.innerHTML = filteredTemplates.map(t => `
    <div class="template-card" data-id="${t.id}">
      <div class="card-header">
        <span class="id">${t.id}</span>
        <span class="category">${t.category}</span>
      </div>
      <h4>${t.name}</h4>
      <p class="publisher">By ${t.publisher}</p>
      <p class="desc">${t.description}</p>
      <span class="tag">${t.tag}</span>
    </div>
  `).join('');
}

function populateCategories() {
  const cats = [...new Set(templates.map(t => t.category))].sort();
  const select = document.getElementById('category-filter');
  select.innerHTML = '<option value="">Semua Kategori</option>' +
    cats.map(c => `<option value="${c}">${c}</option>`).join('');
}

// ===== LIVE LOG =====
function addLog(message) {
  const log = document.getElementById('live-log');
  const li = document.createElement('li');
  li.textContent = `[${new Date().toLocaleTimeString()}] ${message}`;
  log.prepend(li);
  if (log.children.length > 20) log.removeChild(log.lastChild);
}

// ===== EVENT LISTENERS =====
document.getElementById('search-input').addEventListener('input', renderTemplates);
document.getElementById('category-filter').addEventListener('change', renderTemplates);

// ===== INIT =====
loadTemplates();
```

