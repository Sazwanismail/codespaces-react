## 5. FRONTEND LOGIC — `client/app.js`

```javascript
const socket = io();
let templates = [];

socket.on('connect', () => {
  document.getElementById('status-dot').className = 'dot online';
  document.getElementById('status-text').textContent = 'Aktif';
  document.getElementById('live-status').textContent = '🟢 Online';
  addLog('Disambung ke server');
});

socket.on('disconnect', () => {
  document.getElementById('status-dot').className = 'dot offline';
  document.getElementById('status-text').textContent = 'Terputus';
  document.getElementById('live-status').textContent = '🔴 Offline';
  addLog('Terputus dari server');
});

socket.on('template:added', (t) => { templates.push(t); render(); addLog(`➕ ${t.id} - ${t.name}`); updateStats(); });
socket.on('template:updated', (t) => { const i = templates.findIndex(x => x.id === t.id); if (i !== -1) templates[i] = t; render(); addLog(`✏️ ${t.id} - ${t.name}`); });
socket.on('template:deleted', ({ id }) => { templates = templates.filter(x => x.id !== id); render(); addLog(`🗑️ ${id}`); updateStats(); });

async function load() {
  const r = await fetch('/api/templates');
  const j = await r.json();
  templates = j.data;
  render();
  populate();
  updateStats();
}

async function updateStats() {
  const r = await fetch('/api/stats');
  const j = await r.json();
  document.getElementById('total-templates').textContent = j.total;
  document.getElementById('total-categories').textContent = j.categories.length;
}

function render() {
  const s = document.getElementById('search-input').value.toLowerCase();
  const c = document.getElementById('category-filter').value;
  const filtered = templates.filter(t => {
    const ms = !s || t.name.toLowerCase().includes(s) || t.id.toLowerCase().includes(s) || t.publisher.toLowerCase().includes(s);
    const mc = !c || t.category === c;
    return ms && mc;
  });
  document.getElementById('templates').innerHTML = filtered.map(t => `
    <div class="template-card">
      <div class="card-header"><span class="id">${t.id}</span><span class="category">${t.category}</span></div>
      <h4>${t.name}</h4>
      <p class="publisher">By ${t.publisher}</p>
      <p class="desc">${t.description}</p>
      <span class="tag">${t.tag}</span>
    </div>
  `).join('');
}

function populate() {
  const cats = [...new Set(templates.map(t => t.category))].sort();
  document.getElementById('category-filter').innerHTML = '<option value="">Semua Kategori</option>' +
    cats.map(c => `<option value="${c}">${c}</option>`).join('');
}

function addLog(msg) {
  const log = document.getElementById('live-log');
  const li = document.createElement('li');
  li.textContent = `[${new Date().toLocaleTimeString()}] ${msg}`;
  log.prepend(li);
  if (log.children.length > 20) log.removeChild(log.lastChild);
}

document.getElementById('search-input').addEventListener('input', render);
document.getElementById('category-filter').addEventListener('change', render);

load();
```

