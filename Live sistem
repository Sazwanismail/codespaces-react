## 1. BACKEND — `server/index.js`

```javascript
const express = require('express');
const http = require('http');
const { Server } = require('socket.io');
const cors = require('cors');
const path = require('path');
const db = require('./database');

const app = express();
const server = http.createServer(app);
const io = new Server(server, {
  cors: { origin: '*', methods: ['GET', 'POST'] }
});

app.use(cors());
app.use(express.json());
app.use(express.static(path.join(__dirname, '../client')));

// ===== API ROUTES =====

// Dapatkan semua templat
app.get('/api/templates', (req, res) => {
  db.all('SELECT * FROM templates ORDER BY category, name', [], (err, rows) => {
    if (err) return res.status(500).json({ error: err.message });
    res.json({ ref: 'CMC-REF-2026-MSI-003', data: rows });
  });
});

// Dapatkan templat mengikut kategori
app.get('/api/templates/:category', (req, res) => {
  db.all('SELECT * FROM templates WHERE category = ?', [req.params.category], (err, rows) => {
    if (err) return res.status(500).json({ error: err.message });
    res.json({ data: rows });
  });
});

// Tambah templat baharu
app.post('/api/templates', (req, res) => {
  const { id, category, name, publisher, description, tag } = req.body;
  db.run(
    `INSERT INTO templates (id, category, name, publisher, description, tag) 
     VALUES (?, ?, ?, ?, ?, ?)`,
    [id, category, name, publisher, description, tag],
    function (err) {
      if (err) return res.status(500).json({ error: err.message });
      const newTemplate = { id, category, name, publisher, description, tag };
      
      // ===== LIVE UPDATE =====
      io.emit('template:added', newTemplate);
      console.log('📡 Live Update: Templat baharu ditambah', newTemplate.id);
      
      res.status(201).json(newTemplate);
    }
  );
});

// Kemas kini templat
app.put('/api/templates/:id', (req, res) => {
  const { category, name, publisher, description, tag } = req.body;
  db.run(
    `UPDATE templates SET category = ?, name = ?, publisher = ?, description = ?, tag = ? WHERE id = ?`,
    [category, name, publisher, description, tag, req.params.id],
    function (err) {
      if (err) return res.status(500).json({ error: err.message });
      const updated = { id: req.params.id, category, name, publisher, description, tag };
      
      io.emit('template:updated', updated);
      console.log('📡 Live Update: Templat dikemas kini', req.params.id);
      
      res.json(updated);
    }
  );
});

// Padam templat
app.delete('/api/templates/:id', (req, res) => {
  db.run('DELETE FROM templates WHERE id = ?', [req.params.id], function (err) {
    if (err) return res.status(500).json({ error: err.message });
    
    io.emit('template:deleted', { id: req.params.id });
    console.log('📡 Live Update: Templat dipadam', req.params.id);
    
    res.json({ message: 'Templat dipadam', id: req.params.id });
  });
});

// Statistik
app.get('/api/stats', (req, res) => {
  db.get('SELECT COUNT(*) as total FROM templates', [], (err, total) => {
    db.all('SELECT category, COUNT(*) as count FROM templates GROUP BY category', [], (err2, cats) => {
      res.json({ total: total.total, categories: cats });
    });
  });
});

// ===== WEBSOCKET =====
io.on('connection', (socket) => {
  console.log('🔌 Klien disambung:', socket.id);
  
  socket.emit('connected', {
    message: 'Sistem Update Live Aktif',
    ref: 'CMC-REF-2026-MSI-003',
    timestamp: new Date().toISOString()
  });

  socket.on('disconnect', () => {
    console.log('❌ Klien terputus:', socket.id);
  });
});

// ===== START SERVER =====
const PORT = process.env.PORT || 3000;
server.listen(PORT, () => {
  console.log(`🚀 Sistem Update Live berjalan di http://localhost:${PORT}`);
  console.log(`📡 WebSocket aktif untuk live update`);
});
```

