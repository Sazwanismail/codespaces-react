function generateContractCode() {
  const name = document.getElementById('scName')?.value || 'SGAE Sovereign Token';
  const symbol = document.getElementById('scSymbol')?.value || 'S256c';
  const supply = document.getElementById('scSupply')?.value || '21000000';
  
  const code = `// SPDX-License-Identifier: MIT
pragma solidity ^0.8.20;

import "@openzeppelin/contracts/token/ERC20/ERC20.sol";
import "@openzeppelin/contracts/access/Ownable.sol";

contract ${symbol}Token is ERC20, Ownable {
    uint256 public constant MAX_SUPPLY = ${supply} * 10 ** 18;
    mapping(address => string) public notarizedIP;
    
    event IPNotarized(address indexed owner, string ipHash);
    event TokensBurned(address indexed owner, uint256 amount);
    
    constructor() ERC20("${name}", "${symbol}") Ownable(msg.sender) {
        _mint(msg.sender, ${supply} * 10 ** 18);
    }
    
    function burn(uint256 amount) external onlyOwner {
        _burn(msg.sender, amount);
        emit TokensBurned(msg.sender, amount);
    }
    
    function rewardIPHolder(address holder, uint256 amount) external onlyOwner {
        require(totalSupply() + amount <= MAX_SUPPLY, "Max supply exceeded");
        _mint(holder, amount);
    }
    
    function notarizeIP(string calldata ipHash) external {
        notarizedIP[msg.sender] = ipHash;
        emit IPNotarized(msg.sender, ipHash);
    }
}`;
  
  const codeEl = document.getElementById('scCode');
  if (codeEl) codeEl.textContent = code;
}

