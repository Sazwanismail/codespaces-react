function renderVoiceHistory() {
  if (voiceHistory.length === 0) {
    document.getElementById('voiceHistory').innerHTML = '<div style="text-align:center;padding:20px;color:var(--muted)">Tiada sejarah suara lagi</div>';
    return;
  }
  let h = '';
  voiceHistory.slice(-8).reverse().forEach(v => {
    h += `<div class="voice-cmd"><div class="cmd">🎤 ${v.text}</div><div class="action">${v.action}</div></div>`;
  });
  document.getElementById('voiceHistory').innerHTML = h;
}

function toggleVoiceRecognition() {
  if (!('webkitSpeechRecognition' in window) && !('SpeechRecognition' in window)) {
    alert('❌ Pelayar tidak menyokong Voice Recognition.\n\nGuna Chrome atau Edge.');
    return;
  }
  
  if (isVoiceActive) {
    if (voiceRecognition) voiceRecognition.stop();
    isVoiceActive = false;
    document.getElementById('voiceBtn').style.background = 'linear-gradient(135deg,#a855f7,#ec4899)';
    document.getElementById('voiceStatus').textContent = 'Klik butang mikrofon & sebut command';
    return;
  }
  
  const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
  voiceRecognition = new SpeechRecognition();
  voiceRecognition.lang = 'ms-MY';
  voiceRecognition.continuous = false;
  voiceRecognition.interimResults = false;
  
  voiceRecognition.onstart = () => {
    isVoiceActive = true;
    document.getElementById('voiceBtn').style.background = 'linear-gradient(135deg,#ef4444,#dc2626)';
    document.getElementById('voiceStatus').textContent = '🔴 Mendengar... Sebut command';
    document.getElementById('voiceTranscript').textContent = '...';
  };
  
  voiceRecognition.onresult = (event) => {
    const text = event.results[0][0].transcript;
    document.getElementById('voiceTranscript').textContent = '"' + text + '"';
    processVoiceCommand(text);
  };
  
  voiceRecognition.onerror = (event) => {
    document.getElementById('voiceStatus').textContent = '❌ Ralat: ' + event.error;
    isVoiceActive = false;
    document.getElementById('voiceBtn').style.background = 'linear-gradient(135deg,#a855f7,#ec4899)';
  };
  
  voiceRecognition.onend = () => {
    isVoiceActive = false;
    document.getElementById('voiceBtn').style.background = 'linear-gradient(135deg,#a855f7,#ec4899)';
    document.getElementById('voiceStatus').textContent = '✅ Selesai';
  };
  
  voiceRecognition.start();
}

function processVoiceCommand(text) {
  const lower = text.toLowerCase();
  const matched = VOICE_COMMANDS.find(v => v.trigger.some(t => lower.includes(t)));
  
  let action = 'Tiada command dijumpai';
  if (matched) {
    action = matched.action;
    // Execute command
    if (matched.trigger.includes('gran')) document.querySelector('.tab[data-tab="gran"]')?.click();
    else if (matched.trigger.includes('crypto')) document.querySelector('.tab[data-tab="crypto"]')?.click();
    else if (matched.trigger.includes('family')) document.querySelector('.tab[data-tab="keluarga"]')?.click();
    else if (matched.trigger.includes('peta')) document.querySelector('.tab[data-tab="peta"]')?.click();
    else if (matched.trigger.includes('blockchain')) document.querySelector('.tab[data-tab="blockchain"]')?.click();
    else if (matched.trigger.includes('satelit')) document.querySelector('.tab[data-tab="satelit"]')?.click();
    else if (matched.trigger.includes('cuaca')) document.querySelector('.tab[data-tab="cuaca"]')?.click();
    else if (matched.trigger.includes('dashboard')) document.querySelector('.tab[data-tab="liveDashboard"]')?.click();
    else if (matched.trigger.includes('export')) document.querySelector('.tab[data-tab="export"]')?.click();
    else if (matched.trigger.includes('myipo')) document.querySelector('.tab[data-tab="myipo"]')?.click();
  }
  
  voiceHistory.push({ text, action, time: new Date().toISOString() });
  renderVoiceHistory();
  document.getElementById('voiceStatus').textContent = '✅ ' + action;
  
  // Speak response
  if ('speechSynthesis' in window) {
    const utt = new SpeechSynthesisUtterance(action);
    utt.lang = 'ms-MY';
    window.speechSynthesis.speak(utt);
  }
}

