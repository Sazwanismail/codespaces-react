function calculateTax() {
  const income = parseFloat(document.getElementById('taxIncome')?.value) || 0;
  const expense = parseFloat(document.getElementById('taxExpense')?.value) || 0;
  const relief = parseFloat(document.getElementById('taxRelief')?.value) || 0;
  const category = document.getElementById('taxCategory')?.value || 'company';
  
  const taxableIncome = Math.max(0, income - expense - relief);
  let taxRate, taxAmount, effectiveRate;
  
  if (category === 'company') {
    // SME Tax: First 600k = 15%, above 600k = 24%
    if (taxableIncome <= 600000) {
      taxRate = 0.15;
      taxAmount = taxableIncome * 0.15;
    } else {
      taxAmount = 600000 * 0.15 + (taxableIncome - 600000) * 0.24;
      taxRate = '15% / 24%';
    }
  } else if (category === 'individual') {
    // Simplified Malaysia Individual Tax
    if (taxableIncome <= 5000) taxAmount = 0;
    else if (taxableIncome <= 20000) taxAmount = (taxableIncome - 5000) * 0.01;
    else if (taxableIncome <= 35000) taxAmount = 150 + (taxableIncome - 20000) * 0.03;
    else if (taxableIncome <= 50000) taxAmount = 600 + (taxableIncome - 35000) * 0.06;
    else if (taxableIncome <= 70000) taxAmount = 1500 + (taxableIncome - 50000) * 0.11;
    else if (taxableIncome <= 100000) taxAmount = 3700 + (taxableIncome - 70000) * 0.19;
    else if (taxableIncome <= 400000) taxAmount = 9400 + (taxableIncome - 100000) * 0.25;
    else if (taxableIncome <= 600000) taxAmount = 84400 + (taxableIncome - 400000) * 0.26;
    else if (taxableIncome <= 2000000) taxAmount = 136400 + (taxableIncome - 600000) * 0.28;
    else taxAmount = 528400 + (taxableIncome - 2000000) * 0.30;
    taxRate = 'Progressive 0-30%';
  } else {
    taxRate = 0.26;
    taxAmount = taxableIncome * 0.26;
  }
  
  effectiveRate = income > 0 ? (taxAmount / income * 100).toFixed(2) : 0;
  
  document.getElementById('taxResult').innerHTML = `
    <div class="tax-row"><span class="label">Gross Income</span><span class="value">RM ${income.toLocaleString()}</span></div>
    <div class="tax-row"><span class="label">Business Expenses</span><span class="value red">−RM ${expense.toLocaleString()}</span></div>
    <div class="tax-row"><span class="label">Reliefs</span><span class="value red">−RM ${relief.toLocaleString()}</span></div>
    <div class="tax-row"><span class="label">Taxable Income</span><span class="value">RM ${taxableIncome.toLocaleString()}</span></div>
    <div class="tax-row"><span class="label">Tax Rate</span><span class="value">${taxRate}</span></div>
    <div class="tax-row" style="border-top:2px solid var(--gold);padding-top:12px;margin-top:12px">
      <span class="label" style="color:var(--gold);font-weight:700">TOTAL TAX</span>
      <span class="value gold" style="font-size:18px">RM ${Math.round(taxAmount).toLocaleString()}</span>
    </div>
    <div class="tax-row"><span class="label">Effective Rate</span><span class="value cyan">${effectiveRate}%</span></div>
  `;
  
  if (taxChartInst) taxChartInst.destroy();
  const ctx = document.getElementById('taxChart').getContext('2d');
  taxChartInst = new Chart(ctx, {
    type: 'line',
    data: {
      labels: ['2024', '2025', '2026', '2027', '2028'],
      datasets: [{
        label: 'Income (RM)',
        data: [1847000, 2694000, 3847000, 5920000, 9240000],
        borderColor: '#00e5ff',
        backgroundColor: 'rgba(0,229,255,0.1)',
